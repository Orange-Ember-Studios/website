{
	"compatibility_date": "2026-04-03",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "website",
	"main": "dist/_worker.js/index.js",
	"assets": {
		"directory": "dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	}
}
