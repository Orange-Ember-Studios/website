---
import { ChevronDown, Check } from '@lucide/astro';

interface Option {
  id: string;
  label: string;
  color?: string;
  i18nKey?: string;
}

interface Props {
  id: string;
  label?: string;
  options: Option[];
  isMultiple?: boolean;
  initialValues?: string | string[];
  defaultLabel?: string;
  defaultLabelI18n?: string;
  labelI18n?: string;
  class?: string;
  containerId?: string;
  variant?: "default" | "navbar";
}

const {
  id,
  label,
  options,
  isMultiple = false,
  initialValues = [],
  defaultLabel = "Select option",
  defaultLabelI18n,
  labelI18n,
  class: className = "",
  containerId = `select-container-${id}`,
  variant = "default",
} = Astro.props;

const initialValuesArray = Array.isArray(initialValues)
  ? initialValues
  : [initialValues].filter(Boolean);

const isNavbar = variant === "navbar";
---

<div
  class={`premium-select-container ${className} ${isNavbar ? "premium-select-navbar" : ""}`}
  id={containerId}
  data-is-multiple={isMultiple ? "true" : "false"}
  data-id={id}
  data-initial-values={JSON.stringify(initialValuesArray)}
  data-variant={variant}
>
  <div class="relative w-full group">
    {
      label && !isNavbar && (
        <label
          class="text-[10px] uppercase tracking-[0.25em] font-black text-white/30 mb-3 block ml-1"
          data-i18n={labelI18n}
        >
          {label}
        </label>
      )
    }

    <button
      type="button"
      class={`select-trigger w-full flex items-center justify-between bg-white/5 border border-white/10 rounded-2xl text-white font-bold hover:bg-white/10 hover:border-orange-500/50 transition-all duration-300 shadow-xl ${isNavbar ? "px-4 py-2 min-h-[40px] text-xs" : "px-6 py-4 min-h-[60px] text-base"}`}
    >
      <span class="selected-label truncate" data-i18n={defaultLabelI18n}
        >{defaultLabel}</span
      >
      <ChevronDown class={`text-orange-500 transition-transform duration-300 ml-3 arrow-icon ${isNavbar ? "h-4 w-4" : "h-5 w-5"}`} />
    </button>

    <!-- Dropdown Menu -->
    <div
      class={`select-dropdown flex-col hidden absolute top-full mt-4 bg-[#0d0d0d]/98 border border-white/10 rounded-3xl shadow-[0_45px_100px_rgba(0,0,0,0.95)] z-100 transition-all duration-500 origin-top scale-95 opacity-0 w-max overflow-x-hidden backdrop-blur-3xl ${isNavbar ? "right-0 max-w-[180px]" : "left-0 max-w-[250px]"}`}
    >
      <div
        class={`max-h-[440px] overflow-y-auto overflow-x-hidden custom-scrollbar flex flex-col gap-1 w-full ${isNavbar ? "p-1.5" : "p-3"}`}
      >
        {
          options.map((option) => (
            <button
              type="button"
              class={`option-btn flex items-center w-full rounded-xl hover:bg-white/5 transition-all text-left group/opt ${isNavbar ? "px-3 py-2" : "px-6 py-4.5 rounded-[1.25rem]"}`}
              data-value={option.id}
            >
              <div
                class={`shrink-0 border border-white/20 flex items-center justify-center group-[.active]/opt:bg-orange-500 group-[.active]/opt:border-orange-500 group-[.active]/opt:shadow-[0_0_15px_rgba(249,115,22,0.4)] transition-all duration-300 ${isMultiple ? "rounded-lg" : "rounded-full"} ${isNavbar ? "w-4 h-4 mr-3" : "w-6 h-6 mr-5"}`}
              >
                <Check class={`text-white opacity-0 group-[.active]/opt:opacity-100 transition-opacity ${isNavbar ? "h-2.5 w-2.5" : "h-4 w-4"}`} />
              </div>
              <span
                class={`font-bold text-gray-400 group-[.active]/opt:text-white leading-tight transition-colors truncate block grow pr-2 ${isNavbar ? "text-xs" : "text-base tracking-wide"}`}
                data-i18n={option.i18nKey}
                data-tag-id={id === "tag-filter" ? option.id : undefined}
              >
                {option.label}
              </span>
              {option.color && (
                <div
                  class={`ml-auto shrink-0 rounded-full shadow-lg ${option.color} group-hover/opt:scale-125 transition-transform ${isNavbar ? "w-1.5 h-1.5" : "w-2.5 h-2.5"}`}
                />
              )}
            </button>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .custom-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Force display of active states for script interaction */
  .option-btn.active .group-\[\.active\]\/opt\:bg-orange-500 {
    background-color: #f97316 !important;
    border-color: #f97316 !important;
  }

  .option-btn.active .group-\[\.active\]\/opt\:opacity-100 {
    opacity: 1 !important;
  }

  .option-btn.active span {
    color: white !important;
  }
</style>

<script>
  function setupPremiumSelects() {
    const containers = document.querySelectorAll(".premium-select-container");

    containers.forEach((container) => {
      // Prevent multiple initialization
      if (container.getAttribute("data-initialized")) return;
      container.setAttribute("data-initialized", "true");

      const trigger = container.querySelector(".select-trigger");
      const dropdown = container.querySelector(".select-dropdown");
      const arrow = container.querySelector(".arrow-icon");
      const labelElement = container.querySelector(".selected-label");
      const options = container.querySelectorAll(".option-btn");
      const isMultiple = container.getAttribute("data-is-multiple") === "true";
      const selectId = container.getAttribute("data-id");
      const initialValues = JSON.parse(
        container.getAttribute("data-initial-values") || "[]",
      );

      let selectedValues = new Set(initialValues);

      const updateUI = (skipDispatch = false) => {
        options.forEach((opt) => {
          const val = opt.getAttribute("data-value");
          if (selectedValues.has(val)) {
            opt.classList.add("active");
          } else {
            opt.classList.remove("active");
          }
        });

        // Custom event for integration
        if (!skipDispatch) {
          container.dispatchEvent(
            new CustomEvent("change", {
              detail: {
                id: selectId,
                values: Array.from(selectedValues),
                isMultiple,
              },
            }),
          );
        }
      };

      trigger?.addEventListener("click", (e) => {
        e.stopPropagation();
        const isHidden = dropdown?.classList.contains("hidden");

        // Close all other dropdowns first
        document.querySelectorAll(".select-dropdown").forEach((d) => {
          if (d !== dropdown) {
            d.classList.add("scale-95", "opacity-0");
            setTimeout(() => d.classList.add("hidden"), 300);
            d.closest(".premium-select-container")
              ?.querySelector(".arrow-icon")
              ?.classList.remove("rotate-180");
          }
        });

        if (isHidden) {
          dropdown?.classList.remove("hidden");
          setTimeout(() => {
            dropdown?.classList.remove("scale-95", "opacity-0");
            dropdown?.classList.add("scale-100", "opacity-100");
          }, 0);
          arrow?.classList.add("rotate-180");
        } else {
          dropdown?.classList.add("scale-95", "opacity-0");
          dropdown?.classList.remove("scale-100", "opacity-100");
          setTimeout(() => dropdown?.classList.add("hidden"), 300);
          arrow?.classList.remove("rotate-180");
        }
      });

      options.forEach((opt) => {
        opt.addEventListener("click", (e) => {
          e.stopPropagation();
          const value = opt.getAttribute("data-value");

          if (isMultiple) {
            if (value === "all") {
              selectedValues.clear();
              selectedValues.add("all");
            } else {
              selectedValues.delete("all");
              if (selectedValues.has(value)) {
                selectedValues.delete(value);
                if (selectedValues.size === 0) selectedValues.add("all");
              } else {
                selectedValues.add(value);
              }
            }
          } else {
            selectedValues.clear();
            selectedValues.add(value);
            // Close dropdown for single select
            dropdown?.classList.add("scale-95", "opacity-0");
            dropdown?.classList.remove("scale-100", "opacity-100");
            setTimeout(() => dropdown?.classList.add("hidden"), 300);
            arrow?.classList.remove("rotate-180");
          }

          updateUI();
        });
      });

      // Global click to close
      document.addEventListener("click", () => {
        dropdown?.classList.add("scale-95", "opacity-0");
        dropdown?.classList.remove("scale-100", "opacity-100");
        setTimeout(() => dropdown?.classList.add("hidden"), 300);
        arrow?.classList.remove("rotate-180");
      });

      // Initialize UI with initial values but skip dispatch to avoid loops
      updateUI(true);
    });
  }

  // Run on load
  setupPremiumSelects();

  // Also run on document transitions if using ViewTransitions
  document.addEventListener("astro:page-load", setupPremiumSelects);
</script>
