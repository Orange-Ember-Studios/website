---
// src/components/Navigation/Navbar.astro
---

<nav 
  id="main-nav"
  class="fixed top-0 left-0 w-full z-50 transition-all duration-500 py-6"
>
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
    
    {/* Logo Section */}
    <a href="#" class="flex items-center gap-3 group">
      <div class="w-10 h-10 relative">
        <img 
          src="/Shield.svg" 
          alt="Orange Ember Shield" 
          class="w-full h-full object-contain filter drop-shadow-[0_0_8px_rgba(255,91,13,0.5)] group-hover:scale-110 transition-transform duration-300"
        />
      </div>
      <span class="text-white font-bold text-xl tracking-tight hidden sm:block">
        Orange <span class="text-studio-flame-light">Ember</span>
      </span>
    </a>

    {/* Navigation Links */}
    <div class="hidden md:flex items-center gap-10">
      <a href="#portfolio" class="text-sm font-medium text-gray-300 hover:text-studio-flame-light transition-colors uppercase tracking-widest">Portfolio</a>
      <a href="#services" class="text-sm font-medium text-gray-300 hover:text-studio-flame-light transition-colors uppercase tracking-widest">Services</a>
      <a href="#about" class="text-sm font-medium text-gray-300 hover:text-studio-flame-light transition-colors uppercase tracking-widest">About</a>
      <a 
        href="#contact" 
        class="px-6 py-2 border border-studio-flame-mid/30 rounded-full text-sm font-semibold text-white bg-studio-shield/20 hover:bg-studio-flame-mid transition-all duration-300 hover:shadow-[0_0_15px_rgba(255,91,13,0.3)]"
      >
        Work with us
      </a>
    </div>

    {/* Mobile Menu Button */}
    <button id="mobile-menu-btn" aria-controls="mobile-menu" aria-expanded="false" class="md:hidden text-white hover:text-studio-flame-light transition-colors z-50 relative">
      <svg id="menu-icon" class="w-8 h-8 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
      {/* Close Icon (hidden by default) */}
      <svg id="close-icon" class="w-8 h-8 transition-transform duration-300 hidden absolute top-0 left-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</nav>

{/* Full Screen Mobile Menu Overlay */}
<div id="mobile-menu" class="fixed inset-0 bg-studio-bg/95 backdrop-blur-2xl z-40 flex flex-col items-center justify-center translate-x-full transition-transform duration-500 ease-in-out md:hidden">
  <div class="flex flex-col items-center gap-8">
    <a href="#portfolio" class="mobile-link text-2xl font-bold text-white hover:text-studio-flame-light transition-colors uppercase tracking-widest">Portfolio</a>
    <a href="#services" class="mobile-link text-2xl font-bold text-white hover:text-studio-flame-light transition-colors uppercase tracking-widest">Services</a>
    <a href="#about" class="mobile-link text-2xl font-bold text-white hover:text-studio-flame-light transition-colors uppercase tracking-widest">About</a>
    <a 
      href="#contact" 
      class="mobile-link px-8 py-3 mt-4 border border-studio-flame-mid/30 rounded-full text-lg font-bold text-white bg-studio-shield/20 hover:bg-studio-flame-mid transition-all duration-300"
    >
      Work with us
    </a>
  </div>
</div>

<script>
  const nav = document.getElementById('main-nav');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  
  let isMenuOpen = false;

  const toggleMenu = () => {
    isMenuOpen = !isMenuOpen;
    mobileBtn?.setAttribute('aria-expanded', isMenuOpen.toString());
    
    if (isMenuOpen) {
      mobileMenu?.classList.remove('translate-x-full');
      mobileMenu?.classList.add('translate-x-0');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.style.overflow = 'hidden'; // Prevent scrolling when open
    } else {
      mobileMenu?.classList.remove('translate-x-0');
      mobileMenu?.classList.add('translate-x-full');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.style.overflow = '';
    }
  };

  mobileBtn?.addEventListener('click', toggleMenu);

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      if(isMenuOpen) toggleMenu();
    });
  });

  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      nav?.classList.add('bg-studio-bg/80', 'backdrop-blur-xl', 'py-4', 'border-b', 'border-white/5');
      nav?.classList.remove('py-6');
    } else {
      nav?.classList.remove('bg-studio-bg/80', 'backdrop-blur-xl', 'py-4', 'border-b', 'border-white/5');
      nav?.classList.add('py-6');
    }
  });
</script>
