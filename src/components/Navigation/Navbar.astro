---
// src/components/Navigation/Navbar.astro
---

<nav 
  id="main-nav"
  class="fixed top-0 left-0 w-full z-50 transition-all duration-500 py-6"
>
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
    
    {/* Logo Section */}
    <a href="#" class="flex items-center gap-3 group">
      <div class="w-10 h-10 relative">
        <img 
          src="/Shield.svg" 
          alt="Orange Ember Shield" 
          class="w-full h-full object-contain filter drop-shadow-[0_0_8px_rgba(255,91,13,0.5)] group-hover:scale-110 transition-transform duration-300"
        />
      </div>
      <span class="text-white font-bold text-xl tracking-tight hidden sm:block">
        Orange <span class="text-studio-flame-light">Ember</span>
      </span>
    </a>

    {/* Navigation Links */}
    <div class="hidden md:flex items-center gap-10">
      <a href="#portfolio" class="text-sm font-medium text-gray-300 hover:text-studio-flame-light transition-colors uppercase tracking-widest">Portfolio</a>
      <a href="#services" class="text-sm font-medium text-gray-300 hover:text-studio-flame-light transition-colors uppercase tracking-widest">Services</a>
      <a href="#about" class="text-sm font-medium text-gray-300 hover:text-studio-flame-light transition-colors uppercase tracking-widest">About</a>
      <a 
        href="#contact" 
        class="px-6 py-2 border border-studio-flame-mid/30 rounded-full text-sm font-semibold text-white bg-studio-shield/20 hover:bg-studio-flame-mid transition-all duration-300 hover:shadow-[0_0_15px_rgba(255,91,13,0.3)]"
      >
        Work with us
      </a>
    </div>

    {/* Mobile Menu Button (Simplified for now) */}
    <button class="md:hidden text-white">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>
  </div>
</nav>

<script>
  const nav = document.getElementById('main-nav');
  
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      nav?.classList.add('bg-studio-bg/80', 'backdrop-blur-xl', 'py-4', 'border-b', 'border-white/5');
      nav?.classList.remove('py-6');
    } else {
      nav?.classList.remove('bg-studio-bg/80', 'backdrop-blur-xl', 'py-4', 'border-b', 'border-white/5');
      nav?.classList.add('py-6');
    }
  });
</script>
