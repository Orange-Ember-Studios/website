---
// src/components/Navigation/Navbar.astro
import PremiumLanguageSelector from "../LanguageSelector/PremiumLanguageSelector.astro";
import { LogOut, LogIn, Menu, X, User } from '@lucide/astro';
const { lang = Astro.params.lang || "en" } = Astro.props;
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 w-full z-50 transition-all duration-500 py-6"
  transition:persist
>
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
    {/* Logo Section */}
    <a href={`/${lang}/`} class="flex items-center gap-3 group">
      <div class="w-10 h-10 relative">
        <img
          src="/Shield.svg"
          alt="Orange Ember Shield"
          class="w-full h-full object-contain filter drop-shadow-[0_0_8px_rgba(255,91,13,0.5)] group-hover:scale-110 transition-transform duration-300"
        />
      </div>
      <span class="text-white font-bold text-xl tracking-tight hidden sm:block">
        Orange <span class="text-ember-400">Ember</span>
      </span>
    </a>

    {/* Navigation Links */}
    <div class="hidden md:flex items-center gap-8">
      <a
        href={`/${lang}/#portfolio`}
        data-i18n="nav.portfolio"
        class="text-sm font-medium text-gray-300 hover:text-ember-400 transition-colors uppercase tracking-widest"
        >Portfolio</a
      >
      <a
        href={`/${lang}/#services`}
        data-i18n="nav.services"
        class="text-sm font-medium text-gray-300 hover:text-ember-400 transition-colors uppercase tracking-widest"
        >Services</a
      >
      <a
        href={`/${lang}/#about`}
        data-i18n="nav.about"
        class="text-sm font-medium text-gray-300 hover:text-ember-400 transition-colors uppercase tracking-widest"
        >About</a
      >
      <a
        href={`/${lang}/blog`}
        data-i18n="nav.blog"
        class="text-sm font-medium text-gray-300 hover:text-ember-400 transition-colors uppercase tracking-widest"
        >Blog</a
      >
      <a
        href={`/${lang}/#contact`}
        data-i18n="nav.workWithUs"
        class="px-6 py-2 border border-ember-500/30 rounded-full text-sm font-semibold text-white bg-void-500/20 hover:bg-ember-500 transition-all duration-300 hover:shadow-[0_0_15px_rgba(255,91,13,0.3)]"
      >
        Work with us
      </a>
      <a
        href="https://buymeacoffee.com/seobryn"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold text-amber-300 bg-amber-500/10 border border-amber-500/30 hover:bg-amber-500/20 hover:border-amber-500/50 transition-all duration-300"
        title="Support us on Buy Me a Coffee"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M2 21h18v-2H2v2zm2-4h14V9H4v8zm2-6h10v2H6V11zm2-4h6v2H8V7z"/>
        </svg>
        Donate
      </a>
      <PremiumLanguageSelector lang={lang} id="desktop-lang-selector" />
      <a
        href="/admin"
        class="flex items-center justify-center w-10 h-10 rounded-full bg-white/5 border border-white/10 text-gray-400 hover:text-ember-400 hover:border-ember-500/50 transition-all duration-300 group/nav-login"
        title={Astro.locals.user ? "Dashboard" : "Login"}
      >
        {Astro.locals.user ? (
          <LogOut class="h-5 w-5 group-hover/nav-login:scale-110 transition-transform" />
        ) : (
          <LogIn class="h-5 w-5 group-hover/nav-login:scale-110 transition-transform" />
        )}
      </a>
    </div>

    {/* Mobile Menu Button ... */}
    <button
      id="mobile-menu-btn"
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="md:hidden text-white hover:text-ember-400 transition-colors z-50 relative"
    >
      <Menu id="menu-icon" class="w-8 h-8 transition-transform duration-300" />
      {/* Close Icon (hidden by default) */}
      <X
        id="close-icon"
        class="w-8 h-8 transition-transform duration-300 hidden absolute top-0 left-0"
      />
    </button>
  </div>
</nav>

{/* Full Screen Mobile Menu Overlay */}
<div
  id="mobile-menu"
  class="fixed inset-0 bg-ash-950/95 backdrop-blur-2xl z-50 flex flex-col items-center justify-center translate-x-full transition-transform duration-500 ease-in-out md:hidden text-center"
>
  <div class="flex flex-col items-center gap-8">
    <a
      href={`/${lang}/#portfolio`}
      data-i18n="nav.portfolio"
      class="mobile-link text-2xl font-bold text-white hover:text-ember-400 transition-colors uppercase tracking-widest"
      >Portfolio</a
    >
    <a
      href={`/${lang}/#services`}
      data-i18n="nav.services"
      class="mobile-link text-2xl font-bold text-white hover:text-ember-400 transition-colors uppercase tracking-widest"
      >Services</a
    >
    <a
      href={`/${lang}/#about`}
      data-i18n="nav.about"
      class="mobile-link text-2xl font-bold text-white hover:text-ember-400 transition-colors uppercase tracking-widest"
      >About</a
    >
    <a
      href={`/${lang}/blog`}
      data-i18n="nav.blog"
      class="mobile-link text-2xl font-bold text-white hover:text-ember-400 transition-colors uppercase tracking-widest"
      >Blog</a
    >
<a
        href={`/${lang}/#contact`}
        data-i18n="nav.workWithUs"
        class="mobile-link px-8 py-3 mt-4 border border-ember-500/30 rounded-full text-lg font-bold text-white bg-void-500/20 hover:bg-ember-500 transition-all duration-300"
      >
        Work with us
    </a>
    <a
        href="https://buymeacoffee.com/seobryn"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-link flex items-center gap-2 px-6 py-3 mt-4 rounded-full text-base font-semibold text-amber-300 bg-amber-500/10 border border-amber-500/30 hover:bg-amber-500/20 transition-all duration-300"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M2 21h18v-2H2v2zm2-4h14V9H4v8zm2-6h10v2H6V11zm2-4h6v2H8V7z"/>
        </svg>
        Donate
    </a>
    <div class="mt-4 flex flex-col items-center gap-6">
      <PremiumLanguageSelector lang={lang} id="mobile-lang-selector" />
      <a
        href="/admin"
        class="mobile-link flex items-center gap-3 text-lg font-medium text-gray-400 hover:text-ember-400 transition-colors"
      >
        <User class="h-6 w-6" />
        {Astro.locals.user ? "Dashboard" : "Admin Login"}
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const nav = document.getElementById("main-nav");
    const mobileBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    let isMenuOpen = false;

    const toggleMenu = () => {
      isMenuOpen = !isMenuOpen;
      mobileBtn?.setAttribute("aria-expanded", isMenuOpen.toString());

      if (isMenuOpen) {
        mobileMenu?.classList.remove("translate-x-full");
        mobileMenu?.classList.add("translate-x-0");
        menuIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
        document.body.style.overflow = "hidden"; // Prevent scrolling when open
      } else {
        mobileMenu?.classList.remove("translate-x-0");
        mobileMenu?.classList.add("translate-x-full");
        menuIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
        document.body.style.overflow = "";
      }
    };

    mobileBtn?.addEventListener("click", toggleMenu);

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (isMenuOpen) toggleMenu();
      });
    });

    window.addEventListener("scroll", () => {
      if (window.scrollY > 50) {
        nav?.classList.add(
          "bg-ash-950/80",
          "backdrop-blur-xl",
          "py-4",
          "border-b",
          "border-white/5",
        );
        nav?.classList.remove("py-6");
      } else {
        nav?.classList.remove(
          "bg-ash-950/80",
          "backdrop-blur-xl",
          "py-4",
          "border-b",
          "border-white/5",
        );
        nav?.classList.add("py-6");
      }
    });
  });
</script>
