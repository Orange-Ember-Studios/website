---
// src/components/Navigation/Footer.astro
import { SOCIAL_URLS } from "../../constants/urls";
---

<footer class="bg-[#0b0f19] border-t border-white/5 pt-20 pb-10 relative overflow-hidden">
  {/* Subtle decorative glow */}
  <div class="absolute left-1/2 bottom-0 -translate-x-1/2 w-full h-64 bg-studio-shield/5 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      {/* Brand Column */}
      <div class="col-span-1 md:col-span-2">
        <a href="/" class="flex items-center gap-3 group mb-6">
          <div class="w-10 h-10 relative">
            <img
              src="/Shield.svg"
              alt="Orange Ember Shield"
              class="w-full h-full object-contain filter drop-shadow-[0_0_8px_rgba(255,91,13,0.4)] group-hover:scale-110 transition-transform duration-300"
            />
          </div>
          <span class="text-white font-bold text-xl tracking-tight">
            Orange <span class="text-studio-flame-light">Ember</span>
          </span>
        </a>
        <p class="text-gray-400 max-w-sm text-lg leading-relaxed mb-8" data-i18n="hero.description">
          Crafting extraordinary digital experiences. We forge premium video games, web, and mobile applications.
        </p>
        <div class="flex gap-4">
          <a href={SOCIAL_URLS.TWITTER_X} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-studio-flame-light hover:border-studio-flame-mid/50 transition-all duration-300" aria-label="Twitter">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
          </a>
          <a href={SOCIAL_URLS.GITHUB} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-studio-flame-light hover:border-studio-flame-mid/50 transition-all duration-300" aria-label="GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
        </div>
      </div>

      {/* Quick Links */}
      <div>
        <h3 class="text-white font-bold mb-6 tracking-wider uppercase text-sm">Studio</h3>
        <ul class="space-y-4">
          <li><a href="#portfolio" class="text-gray-400 hover:text-studio-flame-light transition-colors text-base" data-i18n="nav.portfolio">Portfolio</a></li>
          <li><a href="#services" class="text-gray-400 hover:text-studio-flame-light transition-colors text-base" data-i18n="nav.services">Services</a></li>
          <li><a href="#about" class="text-gray-400 hover:text-studio-flame-light transition-colors text-base" data-i18n="nav.about">About</a></li>
          <li><a href="#contact" class="text-gray-400 hover:text-studio-flame-light transition-colors text-base" data-i18n="nav.workWithUs">Work with us</a></li>
        </ul>
      </div>

      {/* Legal Links */}
      <div>
        <h3 class="text-white font-bold mb-6 tracking-wider uppercase text-sm">Legal</h3>
        <ul class="space-y-4">
          <li><a href="/privacy" class="text-gray-400 hover:text-studio-flame-light transition-colors text-base" data-i18n="privacy.title">Privacy Policy</a></li>
        </ul>
      </div>
    </div>

    {/* Bottom Footer */}
    <div class="pt-10 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6">
      <p class="text-gray-500 text-sm">
        &copy; {new Date().getFullYear()} Orange Ember Studios. All rights reserved.
      </p>
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-studio-flame-mid animate-pulse"></span>
        <span class="text-gray-500 text-sm tracking-wide uppercase">Igniting Ideas since 2024</span>
      </div>
    </div>
  </div>
</footer>
