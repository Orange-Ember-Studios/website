---
import {
  getCurrentLanguage,
  getSupportedLanguages,
  setLanguage,
} from "../../i18n/i18n";
import type { SupportedLanguage } from "../../i18n/i18n";

interface Props {
  lang?: string;
  id?: string;
}

const { lang: propLang, id = "nav-lang-selector" } = Astro.props;

const supportedLanguages = getSupportedLanguages();
const currentLang = (propLang as SupportedLanguage) || getCurrentLanguage();

const langOptions = supportedLanguages.map((lang) => ({
  id: lang.code,
  label: lang.label,
  color:
    lang.code === "en"
      ? "bg-blue-500"
      : lang.code === "es"
        ? "bg-red-500"
        : "bg-white/20",
}));

const currentLangLabel =
  supportedLanguages.find((l) => l.code === currentLang)?.label ||
  "English";
---

<div class="premium-lang-selector-wrapper">
  <div
    id={id}
    class="premium-select-navbar"
    data-lang={currentLang}
  >
    <div class="relative w-full group">
      <button
        type="button"
        class="select-trigger w-full flex items-center justify-between bg-white/5 border border-white/10 rounded-2xl text-white font-bold hover:bg-white/10 hover:border-orange-500/50 transition-all duration-300 shadow-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-ember-500 px-4 py-2 min-h-[40px] text-xs"
      >
        <span class="selected-label truncate">{currentLangLabel}</span>
        <svg
          class="w-4 h-4 text-orange-500 transition-transform duration-300 arrow-icon"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 9l-7 7-7-7"
          />
        </svg>
      </button>

      <div
        class="select-dropdown hidden absolute top-full mt-4 right-0 max-w-[180px] bg-[#0d0d0d]/98 border border-white/10 rounded-3xl shadow-[0_45px_100px_rgba(0,0,0,0.95)] z-[110] transition-all duration-500 origin-top scale-95 opacity-0 w-max overflow-x-hidden backdrop-blur-3xl"
      >
        <div class="p-1.5 flex flex-col gap-1 w-full max-h-[440px] overflow-y-auto custom-scrollbar">
          {langOptions.map((option) => (
            <button
              type="button"
              class={`option-btn flex items-center w-full rounded-xl hover:bg-white/5 transition-all text-left px-3 py-2 ${option.id === currentLang ? "active" : ""}`}
              data-value={option.id}
            >
              <div
                class={`shrink-0 border border-white/20 flex items-center justify-center rounded-full w-4 h-4 mr-3 ${option.id === currentLang ? "bg-orange-500 border-orange-500" : ""}`}
              >
                <svg
                  class="w-2.5 h-2.5 text-white opacity-0 group-[.active]/opt:opacity-100 transition-opacity"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
              </div>
              <span class="font-bold text-gray-400 group-[.active]/opt:text-white text-xs tracking-wide leading-tight">
                {option.label}
              </span>
              <div
                class={`ml-auto shrink-0 rounded-full w-1.5 h-1.5 ${option.color}`}
              />
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const containers = document.querySelectorAll(".premium-select-navbar");

    containers.forEach((container) => {
      if (container.getAttribute("data-initialized")) return;
      container.setAttribute("data-initialized", "true");

      const trigger = container.querySelector(".select-trigger");
      const dropdown = container.querySelector(".select-dropdown");
      const arrow = container.querySelector(".arrow-icon");
      const options = container.querySelectorAll(".option-btn");

      options.forEach((opt) => {
        opt.addEventListener("click", (e) => {
          e.stopPropagation();
          const value = opt.getAttribute("data-value");
          if (!value) return;

          const newLang = value as SupportedLanguage;
          const codes = ["en", "es", "fr"];
          if (!codes.includes(newLang)) return;

          setLanguage(newLang, true);
        });
      });

      trigger?.addEventListener("click", (e) => {
        e.stopPropagation();
        const isHidden = dropdown?.classList.contains("hidden");

        document.querySelectorAll(".select-dropdown").forEach((d) => {
          if (d !== dropdown) {
            d.classList.add("scale-95", "opacity-0");
            setTimeout(() => d.classList.add("hidden"), 300);
          }
        });

        if (isHidden) {
          dropdown?.classList.remove("hidden");
          setTimeout(() => {
            dropdown?.classList.remove("scale-95", "opacity-0");
          }, 0);
          arrow?.classList.add("rotate-180");
        } else {
          dropdown?.classList.add("scale-95", "opacity-0");
          dropdown?.classList.remove("scale-100", "opacity-100");
          setTimeout(() => dropdown?.classList.add("hidden"), 300);
          arrow?.classList.remove("rotate-180");
        }
      });

      document.addEventListener("click", () => {
        dropdown?.classList.add("scale-95", "opacity-0");
        dropdown?.classList.remove("scale-100", "opacity-100");
        setTimeout(() => dropdown?.classList.add("hidden"), 300);
        arrow?.classList.remove("rotate-180");
      });
    });
  });
</script>
