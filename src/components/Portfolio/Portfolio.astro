---
import { SITE_URLS } from "../../constants/urls";
import { getPublishedPostsByType } from "../../lib/posts.service";
import { resolveImageUrl } from "../../lib/images";
import { ExternalLink } from '@lucide/astro';

const { lang = Astro.params.lang || "en" } = Astro.props;

const dbProjects = await getPublishedPostsByType("project");

const projects = dbProjects
  .filter((p) => {
    if (lang === "en") return !p.id.startsWith("es/") && !p.id.startsWith("fr/");
    return p.id.startsWith(`${lang}/`);
  })
  .map((p: any) => {
    const desc = p.data.description || "";
    const meta = p.data.meta;
    let status = meta?.status || "Published";
    let category = meta?.category || "Project";

    let cleanDesc = desc;

    if (!meta) {
      // Fallback for legacy EditorJS formatted projects
      const statusMatch = desc.match(/(?:Status|Estado|Statut):\s*([^.]+)/i);
      if (statusMatch) {
         status = statusMatch[1].trim();
         cleanDesc = cleanDesc.replace(statusMatch[0], "");
      }

      const categoryMatch = desc.match(/(?:Category|Categoría|Catégorie|Categoria):\s*([^.]+)/i);
      if (categoryMatch) {
         category = categoryMatch[1].trim();
         cleanDesc = cleanDesc.replace(categoryMatch[0], "");
      }
      
      // Clean up any stray dots or spaces at the start of the description left over from extraction
      cleanDesc = cleanDesc.replace(/^[.\s]+/, '');
    }

    // Specific external links map logic based on standard slug if applicable
    const slug = p.id.split('/').pop();
    const externalLink = meta?.link || "";
    const isExternal = externalLink.startsWith("http");
    const link = isExternal ? externalLink : `/${lang}/projects/${slug}`;

    return {
      id: p.id,
      title: p.data.title,
      description: meta?.description || cleanDesc,
      titleKey: null,
      category,
      categoryKey: null,
      image: resolveImageUrl(p.data.image),
      status,
      statusKey: null,
      link,
      isExternal,
    };
  });

const portfolioSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": projects.map((project, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "SoftwareApplication",
      "name": project.title,
      "description": project.description,
      "applicationCategory": project.category,
      "image": project.image,
      "url": project.link,
      "author": {
        "@type": "Organization",
        "name": "Orange Ember Studios"
      }
    }
  }))
};
---

<!-- Structured Data for AIs -->
<script type="application/ld+json" set:html={JSON.stringify(portfolioSchema)} />

<section
  id="portfolio"
  aria-label="Portfolio Gallery"
  class="py-24 bg-ash-950 text-white relative"
>
  {/* Decorator element inherited from our theme */}
  <div
    class="absolute top-0 right-0 w-96 h-96 bg-void-500/10 rounded-full blur-[100px] pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="mb-16">
      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4"
      >
        <span data-i18n="portfolio.title">Our</span>
        <span
          data-i18n="portfolio.titleHighlight"
          class="text-transparent bg-clip-text bg-linear-to-r from-ember-400 to-ember-500"
          >Masterpieces</span
        >
      </h2>
      <div
        class="w-24 h-1 bg-linear-to-r from-ember-500 to-ember-700 mb-6 rounded-full"
      >
      </div>
      <p
        data-i18n="portfolio.description"
        class="text-gray-400 max-w-2xl text-lg md:text-xl"
      >
        Explore a curated selection of our most ambitious desktop games, mobile
        experiences, and state-of-the-art web applications.
      </p>
    </div>

    {/* Clean CSS Grid for Portfolio elements */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      {
        projects.map((project) => (
          <a
            href={project.link || "#"}
            target={project.isExternal ? "_blank" : "_self"}
            rel={project.isExternal ? "noopener noreferrer" : ""}
            class={`group relative overflow-hidden rounded-2xl aspect-4/3 md:aspect-video bg-gray-900 shadow-2xl border border-white/5 transition-all duration-700 hover:border-ember-500/40 hover:shadow-[0_0_50px_rgba(255,91,13,0.15)] block ${!project.link ? "cursor-default" : "cursor-pointer"}`}
          >
            <img
              src={project.image}
              alt={`Project: ${project.title}`}
              data-i18n-attr="alt"
              data-i18n={project.titleKey}
              class="w-full h-full object-cover transition-transform duration-[1.5s] ease-out group-hover:scale-110 opacity-60 group-hover:opacity-100 mix-blend-luminosity group-hover:mix-blend-normal"
            />

            {/* Dynamic Hover Overlay */}
            <div class="absolute inset-0 bg-linear-to-t from-ash-950 via-ash-950/60 to-transparent opacity-90 transition-opacity duration-500 group-hover:opacity-80" />

            {/* Status Badge */}
            <div class="absolute top-6 right-6">
              <span
                data-i18n={project.statusKey}
                class={`px-4 py-1.5 rounded-full text-xs font-bold tracking-widest uppercase shadow-lg border backdrop-blur-md
              ${project.status === "Available Now" || project.status === "Early Access" ? "bg-green-500/20 text-green-300 border-green-500/30" : ""}
              ${project.status === "Coming Soon" || project.status === "Publishing" ? "bg-orange-500/20 text-orange-300 border-orange-500/30" : ""}
              ${project.status === "In Development" ? "bg-blue-500/20 text-blue-300 border-blue-500/30" : ""}
            `}
              >
                {project.status}
              </span>
            </div>

            {/* Text Content */}
            <div class="absolute bottom-0 left-0 p-8 lg:p-10 translate-y-4 group-hover:translate-y-0 transition-transform duration-500 ease-out">
              <span class="text-ember-400 font-semibold tracking-[0.2em] uppercase text-xs md:text-sm mb-3 flex items-center gap-2">
                <span data-i18n={project.categoryKey}>{project.category}</span>
                {project.isExternal && (
                  <ExternalLink class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity -translate-x-2 group-hover:translate-x-0 duration-500" />
                )}
              </span>
              <h3
                data-i18n={project.titleKey}
                class="text-3xl md:text-4xl font-bold text-white mb-2"
              >
                {project.title}
              </h3>
              {project.description && (
                <p class="text-gray-400 text-sm md:text-base line-clamp-2 mt-3 group-hover:text-white transition-colors duration-500 delay-100 max-w-sm">
                  {project.description}
                </p>
              )}
            </div>

            {/* Hover interaction glow ring inside the card */}
            <div class="absolute inset-0 border-[3px] border-ember-400/0 group-hover:border-ember-400/20 rounded-2xl transition-colors duration-700 pointer-events-none" />
          </a>
        ))
      }
    </div>
  </div>
</section>
