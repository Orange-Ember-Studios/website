---
// src/components/Portfolio/Portfolio.astro
// US-02: Portfolio Gallery Section

const projects = [
  {
    id: 1,
    title: "Unannounced Title",
    category: "Desktop Game",
    image: "https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070&auto=format&fit=crop",
    status: "Coming Soon",
    link: null
  },
  {
    id: 2,
    title: "Taxi Bogotano Rush",
    category: "Mobile Game",
    image: "https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=2071&auto=format&fit=crop",
    status: "Available Now",
    link: "https://play.google.com/store/apps/details?id=com.ces.taxibogotanorush"
  },
  {
    id: 3,
    title: "Easy Flags",
    category: "Web Application",
    image: "https://images.unsplash.com/photo-1504384308090-c894fdcc538d?q=80&w=2070&auto=format&fit=crop",
    status: "In Development",
    link: "https://easy-flags.orangeember.com/"
  },
  {
    id: 4,
    title: "Bubble Level",
    category: "Mobile App",
    image: "https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?q=80&w=2070&auto=format&fit=crop",
    status: "Publishing",
    link: "https://play.google.com/store/apps/details?id=com.orangeemberstudios.bubblelevel"
  }
];
---

<section id="portfolio" aria-label="Portfolio Gallery" class="py-24 bg-studio-bg text-white relative">
  {/* Decorator element inherited from our theme */}
  <div class="absolute top-0 right-0 w-96 h-96 bg-studio-shield/10 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="mb-16">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4">
        Our <span class="text-transparent bg-clip-text bg-gradient-to-r from-studio-flame-light to-studio-flame-mid">Masterpieces</span>
      </h2>
      <div class="w-24 h-1 bg-gradient-to-r from-studio-flame-mid to-studio-flame-dark mb-6 rounded-full"></div>
      <p class="text-gray-400 max-w-2xl text-lg md:text-xl">
        Explore a curated selection of our most ambitious desktop games, mobile experiences, and state-of-the-art web applications.
      </p>
    </div>

    {/* Clean CSS Grid for Portfolio elements */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      {projects.map((project) => (
        <a 
          href={project.link || "#"} 
          target={project.link ? "_blank" : "_self"} 
          rel={project.link ? "noopener noreferrer" : ""}
          class={`group relative overflow-hidden rounded-2xl aspect-[4/3] md:aspect-video bg-gray-900 shadow-2xl border border-white/5 transition-all duration-700 hover:border-studio-flame-mid/40 hover:shadow-[0_0_50px_rgba(255,91,13,0.15)] block ${!project.link ? 'cursor-default' : 'cursor-pointer'}`}
        >
          
          <img 
            src={project.image} 
            alt={`Project: ${project.title}`} 
            class="w-full h-full object-cover transition-transform duration-[1.5s] ease-out group-hover:scale-110 opacity-60 group-hover:opacity-100 mix-blend-luminosity group-hover:mix-blend-normal"
          />

          {/* Dynamic Hover Overlay */}
          <div class="absolute inset-0 bg-gradient-to-t from-studio-bg via-studio-bg/60 to-transparent opacity-90 transition-opacity duration-500 group-hover:opacity-80"></div>
          
          {/* Status Badge */}
          <div class="absolute top-6 right-6">
            <span class={`px-4 py-1.5 rounded-full text-xs font-bold tracking-widest uppercase shadow-lg border backdrop-blur-md
              ${project.status === 'Available Now' ? 'bg-green-500/20 text-green-300 border-green-500/30' : ''}
              ${project.status === 'Coming Soon' || project.status === 'Publishing' ? 'bg-orange-500/20 text-orange-300 border-orange-500/30' : ''}
              ${project.status === 'In Development' ? 'bg-blue-500/20 text-blue-300 border-blue-500/30' : ''}
            `}>
              {project.status}
            </span>
          </div>

          {/* Text Content */}
          <div class="absolute bottom-0 left-0 p-8 lg:p-10 translate-y-4 group-hover:translate-y-0 transition-transform duration-500 ease-out">
            <span class="text-studio-flame-light font-semibold tracking-[0.2em] uppercase text-xs md:text-sm mb-3 block flex items-center gap-2">
              {project.category}
              {project.link && (
                <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity -translate-x-2 group-hover:translate-x-0 duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              )}
            </span>
            <h3 class="text-3xl md:text-4xl font-bold text-white mb-2">{project.title}</h3>
          </div>

          {/* Hover interaction glow ring inside the card */}
          <div class="absolute inset-0 border-[3px] border-studio-flame-light/0 group-hover:border-studio-flame-light/20 rounded-2xl transition-colors duration-700 pointer-events-none"></div>
        </a>
      ))}
    </div>
  </div>
</section>
