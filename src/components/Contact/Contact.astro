---
// src/components/Contact/Contact.astro
// US-05: Contact Form Section
import ContactForm from './ContactForm.vue';
---

<section id="contact" aria-label="Contact Us" class="py-24 bg-[#0b0f19] border-t border-white/5 relative overflow-hidden">
  
  {/* Ambient glowing shield backdrop */}
  <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full max-w-4xl bg-studio-shield/20 rounded-full blur-[200px] pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-6 relative z-10">
    <div class="text-center mb-16 relative">
      <span data-i18n="contact.tagline" class="text-studio-flame-light font-semibold tracking-[0.3em] uppercase text-sm md:text-base block mb-4">
        Ready to Build?
      </span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white mb-6">
        <span data-i18n="contact.title">Let's</span> <span data-i18n="contact.titleHighlight" class="text-transparent bg-clip-text bg-gradient-to-r from-studio-shield via-studio-flame-mid to-studio-flame-light">Connect</span>
      </h2>
      <p data-i18n="contact.description" class="text-gray-400 max-w-2xl mx-auto text-lg md:text-xl leading-relaxed">
        Whether you have a game prototype, an app idea, or just want to say hi, we're all ears. Drop us a message below.
      </p>
    </div>

    <div class="bg-[#13141a] border border-white/10 rounded-3xl p-8 md:p-12 shadow-2xl relative max-w-4xl mx-auto">
       {/* High-end decorative corner accents */}
       <div class="absolute top-0 left-0 w-16 h-16 border-t-2 border-l-2 border-studio-flame-mid/50 rounded-tl-3xl pointer-events-none"></div>
       <div class="absolute bottom-0 right-0 w-16 h-16 border-b-2 border-r-2 border-studio-flame-light/50 rounded-br-3xl pointer-events-none"></div>
       
       {/* Our highly interactive Vue Form component */}
       <ContactForm client:visible />
    </div>

    {/* Social links / alternative contact (Optional but good for completeness) */}
    <div class="mt-16 flex flex-col md:flex-row justify-center items-center gap-8 text-gray-400">
      <a href="mailto:hello@orangeember.com" class="hover:text-studio-flame-light transition-colors flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        hello@orangeember.com
      </a>
      <div class="hidden md:block w-1.5 h-1.5 rounded-full bg-white/20"></div>
      <a href="https://x.com/OrangeEmberSt" target="_blank" rel="noopener noreferrer" class="hover:text-studio-flame-light transition-colors flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
        @OrangeEmberSt
      </a>
    </div>

  </div>
</section>
