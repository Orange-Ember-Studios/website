---
// Hero.astro
// US-01: Landing Page Hero Section
---

<section
  class="relative w-full h-screen min-h-[600px] flex items-center justify-center text-white overflow-hidden"
>
  {/* Dark gradient overlay for a premium feel */}
  <div
    class="absolute inset-0 bg-linear-to-b from-transparent to-ash-950/90 z-0 pointer-events-none"
  >
  </div>

  {/* Flowing Ember Glow honoring the Shield and Flame */}
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] md:w-[600px] h-[400px] md:h-[600px] bg-ember-500/20 rounded-full blur-[100px] md:blur-[150px] animate-pulse z-0 pointer-events-none"
  >
  </div>
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[200px] md:w-[300px] h-[200px] md:h-[300px] bg-void-500/30 rounded-full blur-[80px] md:blur-[120px] animate-pulse delay-700 z-0 pointer-events-none"
  >
  </div>

  <div
    class="relative z-10 flex flex-col items-center text-center px-6 max-w-4xl mx-auto"
  >
    <div class="w-24 h-24 mb-10 relative group">
      <div
        class="absolute inset-0 bg-ember-500/30 rounded-full blur-2xl animate-pulse"
      >
      </div>
      <img
        src="/Shield.svg"
        alt="Orange Ember Shield"
        class="w-full h-full object-contain filter drop-shadow-[0_0_15px_rgba(255,91,13,0.6)] group-hover:scale-110 transition-transform duration-500 relative z-10"
      />
    </div>

    <span
      data-i18n="hero.tagline"
      class="text-ember-400 font-semibold tracking-[0.3em] uppercase mb-4 text-sm md:text-base"
    >
      Create. Ignite. Play.
    </span>

    <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight mb-6">
      <span
        data-i18n="hero.studioName"
        class="text-transparent bg-clip-text bg-linear-to-br from-ember-400 via-ember-500 to-ember-700"
        >Orange Ember</span
      >
      <span data-i18n="hero.studioSuffix">Studios</span>
    </h1>

    <p
      data-i18n="hero.description"
      class="text-lg md:text-2xl text-gray-300 mb-10 max-w-3xl leading-relaxed"
    >
      Crafting extraordinary digital experiences. We forge premium video games,
      web, and mobile applications.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
      <a
        href="#portfolio"
        data-i18n="hero.viewPortfolio"
        class="px-8 py-4 bg-linear-to-r from-ember-500 to-ember-700 hover:from-ember-400 hover:to-ember-500 text-white font-semibold rounded-full transition-all duration-300 hover:scale-[1.03] hover:shadow-[0_0_30px_rgba(255,156,42,0.4)] min-w-[200px]"
      >
        View Portfolio
      </a>
      <a
        href="#contact"
        data-i18n="hero.contactUs"
        class="px-8 py-4 bg-transparent border border-void-500 hover:border-ember-400 text-gray-300 hover:text-white font-semibold rounded-full transition-all duration-300 hover:bg-void-500/20 min-w-[200px]"
      >
        Contact Us
      </a>
    </div>
  </div>
</section>
