---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navigation/Navbar.astro";
import Footer from "../../components/Navigation/Footer.astro";
import PremiumSelect from "../../components/ui/PremiumSelect.astro";
import { getTranslation } from "../../i18n/i18n";
import { getPublishedPostsByType } from "../../lib/posts.service";
import { resolveImageUrl } from "../../lib/images";

const { lang = "en" } = Astro.props;

const url = new URL(Astro.request.url);
const sortOrder = url.searchParams.get("sort") || "desc";

const allPosts = await getPublishedPostsByType('blog');

// Filter posts by language server-side
const posts = allPosts.filter((p) => {
  if (lang === "en") return !p.id.startsWith("es/") && !p.id.startsWith("fr/");
  return p.id.startsWith(`${lang}/`);
});

posts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return sortOrder === "desc" ? dateB - dateA : dateA - dateB;
});

const allTags = [
  ...new Set(posts.flatMap((post) => post.data.tags || [])),
].sort();

import {
  tagTranslations,
  tagColors,
  getTagStyle,
  getTagColor,
} from "./tagMetadata";

const getPostLang = (id: string) => {
  if (id.startsWith("es/")) return "es";
  if (id.startsWith("fr/")) return "fr";
  return "en";
};

// Tag ID to Language mapping for dynamic filtering
const tagsByLang = {
  en: [
    ...new Set(
      allPosts
        .filter((p) => getPostLang(p.id) === "en")
        .flatMap((p) => p.data.tags || []),
    ),
  ],
  es: [
    ...new Set(
      allPosts
        .filter((p) => getPostLang(p.id) === "es")
        .flatMap((p) => p.data.tags || []),
    ),
  ],
  fr: [
    ...new Set(
      allPosts
        .filter((p) => getPostLang(p.id) === "fr")
        .flatMap((p) => p.data.tags || []),
    ),
  ],
};

const tagOptions = [
  { id: "all", label: "All Topics", i18nKey: "blog.allTopics" },
  ...allTags.map((tag) => ({
    id: tag,
    label: tag,
    color: getTagColor(tag),
    i18nKey: `tag.${tag}`,
  })),
];

const sortOptions = [
  { id: "desc", label: "Newest First", i18nKey: "blog.newest" },
  { id: "asc", label: "Oldest First", i18nKey: "blog.oldest" },
];
---

<Layout
  title={`${getTranslation("blog.indexTitlePrefix", lang as any)}${getTranslation("blog.indexTitleHighlight", lang as any)}${getTranslation("blog.indexTitleSuffix", lang as any)} | Orange Ember Studios`}
  description={getTranslation("blog.indexDescription", lang as any)}
>
  <Navbar />

  <main class="pt-32 pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <header class="mb-20 text-center animate-fade-in">
      <h1
        class="text-5xl sm:text-7xl font-extrabold text-white mb-6 tracking-tight"
      >
        <span data-i18n="blog.indexTitlePrefix"
          >{getTranslation("blog.indexTitlePrefix", lang as any)}</span
        ><span
          class="text-transparent bg-clip-text bg-linear-to-r from-orange-500 to-red-600"
          data-i18n="blog.indexTitleHighlight"
          >{getTranslation("blog.indexTitleHighlight", lang as any)}</span
        ><span data-i18n="blog.indexTitleSuffix"
          >{getTranslation("blog.indexTitleSuffix", lang as any)}</span
        >
      </h1>
      <p
        class="text-xl text-gray-400 max-w-2xl mx-auto"
        data-i18n="blog.indexDescription"
      >
        {getTranslation("blog.indexDescription", lang as any)}
      </p>
    </header>

    <div
      class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8 animate-fade-in"
      style="animation-delay: 200ms; z-index: 40; position: relative;"
    >
      <!-- Reusable Premium Select for Tags -->
      <PremiumSelect
        id="tag-filter"
        label={getTranslation("blog.filterByTopics", lang as any)}
        labelI18n="blog.filterByTopics"
        options={tagOptions}
        isMultiple={true}
        initialValues={["all"]}
        defaultLabel="All Topics"
        defaultLabelI18n="blog.allTopics"
        class="w-full md:w-auto"
        containerId="tag-filter-container"
      />

      <!-- Posts Stats and Sort -->
      <div class="flex flex-col sm:flex-row items-end gap-6 w-full md:w-auto">
        <div class="w-full sm:w-auto">
          <label
            class="text-[10px] uppercase tracking-[0.25em] font-black text-white/30 mb-3 block ml-1"
            data-i18n="blog.statistics"
            >{getTranslation("blog.statistics", lang as any)}</label
          >
          <div
            class="flex items-center space-x-3 text-gray-400 bg-white/5 px-6 rounded-2xl border border-white/10 shadow-lg min-h-[60px]"
          >
            <span
              class="text-[9px] font-black uppercase tracking-[0.15em] text-white/50"
              data-i18n="blog.showing">Showing:</span
            >
            <span
              id="posts-count"
              class="text-orange-500 font-black text-2xl leading-none">0</span
            >
            <span
              class="text-[9px] font-black uppercase tracking-[0.15em] text-white/50"
              data-i18n="blog.posts">Posts</span
            >
          </div>
        </div>

        <!-- Reusable Premium Select for Sort -->
        <PremiumSelect
          id="sort-filter"
          label={getTranslation("blog.sortResults", lang as any)}
          labelI18n="blog.sortResults"
          options={sortOptions}
          isMultiple={false}
          initialValues={[sortOrder]}
          defaultLabel={sortOrder === "desc" ? "Newest First" : "Oldest First"}
          defaultLabelI18n={sortOrder === "desc"
            ? "blog.newest"
            : "blog.oldest"}
          class="w-full sm:w-64"
          containerId="sort-filter-container"
        />
      </div>
    </div>

    <!-- Pass metadata to script -->
    <div
      id="blog-metadata"
      class="hidden"
      data-translations={JSON.stringify(tagTranslations)}
      data-tags-by-lang={JSON.stringify(tagsByLang)}
    >
    </div>

    <div
      id="posts-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
    >
      {
        posts.map((post) => (
          <a
            href={`/${lang}/blog/${post.id.replace(`${lang}/`, "")}`}
            data-post-lang={getPostLang(post.id)}
            data-tags={post.data.tags?.join(",")}
            class="hidden group relative bg-white/5 border border-white/10 rounded-[2.5rem] overflow-hidden hover:border-orange-500/50 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_50px_-12px_rgba(249,115,22,0.2)]"
          >
            {post.data.image && (
              <div class="aspect-16/10 overflow-hidden">
                <img
                  src={resolveImageUrl(post.data.image)}
                  alt={post.data.title}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  transition:name={`image-${post.id}`}
                />
              </div>
            )}

            <div class="p-8">
              <div class="flex flex-wrap items-center gap-2 mb-4">
                {post.data.tags?.slice(0, 3).map((tag) => (
                  <span class={getTagStyle(tag)}>
                    <span data-tag-id={tag}>{tag}</span>
                  </span>
                ))}
                <span class="text-xs text-gray-500 ml-auto">
                  {post.data.pubDate.toLocaleDateString(
                    lang === "en" ? "en-US" : lang === "es" ? "es-ES" : "fr-FR",
                    {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    },
                  )}
                </span>
              </div>

              <h2
                class="text-2xl font-bold text-white mb-4 leading-snug group-hover:text-orange-400 transition-colors"
                transition:name={`title-${post.id}`}
              >
                {post.data.title}
              </h2>

              <p 
                class="text-gray-400 line-clamp-3 mb-6 text-sm leading-relaxed"
                set:html={post.data.description}
              />

              <div class="flex items-center text-white font-bold text-sm group-hover:translate-x-1 transition-transform">
                <span data-i18n="blog.readStory">
                  {getTranslation("blog.readStory", lang as any)}
                </span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 ml-2 text-orange-500"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"
                  />
                </svg>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Empty State -->
    <div
      id="blog-empty-state"
      class="hidden flex-col items-center justify-center py-20 text-center"
    >
      <div
        class="w-20 h-20 mb-6 rounded-full bg-white/5 flex items-center justify-center text-orange-500"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-10 w-10"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10l4 4v10a2 2 0 01-2 2z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 4v4h4"></path>
        </svg>
      </div>
      <h3
        class="text-2xl font-bold text-white mb-2"
        data-i18n="blog.noPostsTitle"
      >
        No posts found
      </h3>
      <p class="text-gray-400 max-w-sm" data-i18n="blog.noPostsDesc">
        We haven't published any stories with these criteria yet. Stay tuned!
      </p>
    </div>

    <!-- Pagination / Progressive Loading UI -->
    <div
      id="blog-pagination"
      class="mt-20 flex-col items-center animate-fade-in hidden"
      style="animation-delay: 400ms;"
    >
      <div class="mb-8 flex flex-col items-center w-full max-w-xs">
        <div class="flex justify-between w-full mb-3 px-1">
          <span
            class="text-[10px] uppercase tracking-[0.2em] font-black text-white/40"
            id="pagination-status"
          >
            {
              getTranslation("blog.showingCount", lang as any)
                .replace("{visible}", "0")
                .replace("{total}", "0")
            }
          </span>
        </div>
        <div
          class="w-full h-1 bg-white/5 rounded-full overflow-hidden border border-white/5"
        >
          <div
            id="pagination-progress"
            class="h-full bg-linear-to-r from-orange-500 to-red-600 transition-all duration-700 ease-out"
            style="width: 0%"
          >
          </div>
        </div>
      </div>

      <button
        id="load-more-btn"
        class="group relative px-10 py-5 bg-white/5 border border-white/10 rounded-2xl text-white font-black uppercase tracking-[0.2em] text-xs hover:bg-orange-500 hover:border-orange-500 transition-all duration-500 hover:shadow-[0_0_40px_rgba(249,115,22,0.4)] active:scale-95 cursor-pointer overflow-hidden"
      >
        <span class="relative z-10 flex items-center">
          <span data-i18n="blog.loadMore"
            >{getTranslation("blog.loadMore", lang as any)}</span
          >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 ml-3 transition-transform duration-500 group-hover:rotate-90"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="3"
              d="M12 4v16m8-8H4"></path>
          </svg>
        </span>
        <div
          class="absolute inset-0 bg-linear-to-r from-orange-600 to-red-600 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
        >
        </div>
      </button>

      <p
        id="all-loaded-msg"
        class="hidden text-gray-500 text-sm font-medium italic"
        data-i18n="blog.allLoaded"
      >
        {getTranslation("blog.allLoaded", lang as any)}
      </p>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { getCurrentLanguage, getTranslation } from "../../i18n/i18n";

  document.addEventListener("astro:page-load", () => {
    const DEFAULT_PAGE_SIZE = 9;
    let visibleLimit = DEFAULT_PAGE_SIZE;
    let selectedTags = new Set<string>();
    const metadata = document.getElementById("blog-metadata");
    const tagsByLang = metadata
      ? JSON.parse(metadata.getAttribute("data-tags-by-lang") || "{}")
      : {};
    const tagFilterContainer = document.getElementById("tag-filter-container");
    const sortFilterContainer = document.getElementById(
      "sort-filter-container",
    );
    const loadMoreBtn = document.getElementById("load-more-btn");
    const paginationContainer = document.getElementById("blog-pagination");
    const paginationProgress = document.getElementById("pagination-progress");
    const paginationStatus = document.getElementById("pagination-status");
    const allLoadedMsg = document.getElementById("all-loaded-msg");

    const translateTags = () => {
      // Translate tags inside posts
      const tagElements = document.querySelectorAll("[data-tag-id]");
      tagElements.forEach((el) => {
        const tagId = el.getAttribute("data-tag-id");
        if (tagId) {
          el.textContent = getTranslation(`tag.${tagId}`);
        }
      });

      updateTagVisibility();
      updateTagLabels();
      updatePaginationLabels();
    };

    const updatePaginationLabels = () => {
      if (paginationStatus) {
        const visibleDisplay =
          paginationStatus.getAttribute("data-visible") || "0";
        const totalDisplay = paginationStatus.getAttribute("data-total") || "0";
        paginationStatus.textContent = getTranslation("blog.showingCount")
          .replace("{visible}", visibleDisplay)
          .replace("{total}", totalDisplay);
      }

      const loadMoreText = loadMoreBtn?.querySelector(
        "[data-i18n='blog.loadMore']",
      );
      if (loadMoreText)
        loadMoreText.textContent = getTranslation("blog.loadMore");

      if (allLoadedMsg)
        allLoadedMsg.textContent = getTranslation("blog.allLoaded");
    };

    const updateTagLabels = () => {
      const triggerLabel = tagFilterContainer?.querySelector(".selected-label");

      if (selectedTags.size === 0 || selectedTags.has("all")) {
        if (triggerLabel)
          triggerLabel.textContent =
            getTranslation("blog.allTopics") || "All Topics";
      } else if (selectedTags.size === 1) {
        const tagID = Array.from(selectedTags)[0];
        if (triggerLabel)
          triggerLabel.textContent = getTranslation(`tag.${tagID}`);
      } else {
        if (triggerLabel)
          triggerLabel.textContent = `${selectedTags.size} ${getTranslation("blog.selected")}`;
      }

      // Update individual option labels in dropdown
      const options = tagFilterContainer?.querySelectorAll(
        ".option-btn span[data-tag-id]",
      );
      options?.forEach((opt) => {
        const id = opt.getAttribute("data-tag-id");
        if (id) {
          opt.textContent = getTranslation(`tag.${id}`);
        }
      });
    };

    const updateTagVisibility = () => {
      const lang = getCurrentLanguage();
      const currentLangTags = tagsByLang[lang] || [];

      const tagOptionBtns = tagFilterContainer?.querySelectorAll(
        '.option-btn[data-value]:not([data-value="all"])',
      );
      tagOptionBtns?.forEach((btn) => {
        const tag = btn.getAttribute("data-value");
        if (tag && currentLangTags.includes(tag)) {
          (btn as HTMLElement).style.display = "flex";
        } else {
          (btn as HTMLElement).style.display = "none";
          if (tag && selectedTags.has(tag)) {
            selectedTags.delete(tag);
          }
        }
      });

      const separator = tagFilterContainer?.querySelector(
        ".separator",
      ) as HTMLElement;
      if (separator) {
        separator.style.display = currentLangTags.length > 0 ? "block" : "none";
      }
    };

    const filterPosts = (isLoadMore = false) => {
      const currentLang = getCurrentLanguage();
      const posts = document.querySelectorAll("[data-post-lang]");
      const emptyState = document.getElementById("blog-empty-state");
      const postsCount = document.getElementById("posts-count");

      let totalMatching = 0;
      let visibleInFilter = 0;

      // First pass: identify matching posts
      const matchingPosts: HTMLElement[] = [];
      posts.forEach((post) => {
        const postLang = post.getAttribute("data-post-lang");
        const postTags = post.getAttribute("data-tags")?.split(",") || [];

        const langMatch = postLang === currentLang;
        const tagMatch =
          selectedTags.size === 0 ||
          selectedTags.has("all") ||
          Array.from(selectedTags).some((t) => postTags.includes(t));

        if (langMatch && tagMatch) {
          matchingPosts.push(post as HTMLElement);
          totalMatching++;
        } else {
          (post as HTMLElement).classList.remove("block");
          (post as HTMLElement).classList.add("hidden");
          (post as HTMLElement).style.opacity = "0";
          (post as HTMLElement).style.transform = "translateY(20px)";
        }
      });

      // Second pass: apply visibility limit
      matchingPosts.forEach((post, index) => {
        if (index < visibleLimit) {
          const isNewlyVisible = post.classList.contains("hidden");
          post.classList.remove("hidden");
          post.classList.add("block");
          visibleInFilter++;

          // Apply staggered animation for newly revealed posts or on load
          if (isNewlyVisible || !isLoadMore) {
            const staggerDelay = (index % DEFAULT_PAGE_SIZE) * 100;
            setTimeout(() => {
              post.style.transition = "all 0.6s cubic-bezier(0.16, 1, 0.3, 1)";
              post.style.opacity = "1";
              post.style.transform = "translateY(0)";
            }, staggerDelay);
          } else {
            post.style.opacity = "1";
            post.style.transform = "translateY(0)";
          }
        } else {
          post.classList.remove("block");
          post.classList.add("hidden");
        }
      });

      // Update Counts & Stats
      if (postsCount) postsCount.textContent = totalMatching.toString();

      // Update Pagination UI
      if (totalMatching > 0) {
        paginationContainer?.classList.remove("hidden");
        paginationContainer?.classList.add("flex");

        if (visibleInFilter < totalMatching) {
          loadMoreBtn?.classList.remove("hidden");
          allLoadedMsg?.classList.add("hidden");
        } else {
          loadMoreBtn?.classList.add("hidden");
          allLoadedMsg?.classList.remove("hidden");
        }

        // Update Progress Bar
        const percentage = Math.round((visibleInFilter / totalMatching) * 100);
        if (paginationProgress)
          paginationProgress.style.width = `${percentage}%`;

        // Update Status Label
        if (paginationStatus) {
          paginationStatus.setAttribute(
            "data-visible",
            visibleInFilter.toString(),
          );
          paginationStatus.setAttribute("data-total", totalMatching.toString());
          updatePaginationLabels();
        }
      } else {
        paginationContainer?.classList.remove("flex");
        paginationContainer?.classList.add("hidden");
      }

      if (totalMatching === 0) {
        emptyState?.classList.remove("hidden");
        emptyState?.classList.add("flex");
      } else {
        emptyState?.classList.remove("flex");
        emptyState?.classList.add("hidden");
      }
    };

    // Listen to Load More
    loadMoreBtn?.addEventListener("click", () => {
      visibleLimit += DEFAULT_PAGE_SIZE;
      filterPosts(true);
    });

    // Listen to PremiumSelect events
    tagFilterContainer?.addEventListener("change", (e: any) => {
      const { values } = e.detail;
      selectedTags = new Set(values);
      visibleLimit = DEFAULT_PAGE_SIZE; // Reset limit on filter change
      updateTagLabels();
      filterPosts();
    });

    sortFilterContainer?.addEventListener("change", (e: any) => {
      const { values } = e.detail;
      const sortVal = values[0];
      if (sortVal) {
        const url = new URL(window.location.href);
        url.searchParams.set("sort", sortVal);
        window.location.href = url.toString();
      }
    });

    // Run on initial load
    translateTags();
    filterPosts();

    // Listen for language changes
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === "lang") {
          translateTags();
          filterPosts();
        }
      });
    });

    observer.observe(document.documentElement, { attributes: true });

    document.addEventListener("change", (e) => {
      const target = e.target as HTMLSelectElement;
      if (target && target.id === "lang-select") {
        setTimeout(() => {
          translateTags();
          filterPosts();
        }, 0);
      }
    });
  });
</script>

<style>
  .animate-fade-in {
    animation: fadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
