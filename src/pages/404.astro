---
import Layout from "../layouts/Layout.astro";
import { getTranslation } from "../i18n/i18n";
import { ArrowRight } from '@lucide/astro';

// We set the status code to 404
if (Astro.response) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}
---

<Layout title={getTranslation("error404.title")}>
  <main
    class="min-h-screen flex items-center justify-center bg-[#0b0f19] relative overflow-hidden perspective-1000"
    id="parallax-container"
  >
    <!-- Background Shield Glow (Artistic watermark) -->
    <div
      class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-10 select-none"
    >
      <img
        src="/Shield.svg"
        alt=""
        class="w-[120%] max-w-none transform scale-150 blur-xl animate-pulse-slow"
      />
    </div>

    <!-- Floating Embers Particle System -->
    <div
      class="absolute inset-0 pointer-events-none sm:opacity-100 opacity-50"
      id="embers-field"
    >
      {
        Array.from({ length: 15 }).map((_, i) => (
          <div
            class={`ember absolute rounded-full bg-linear-to-t from-orange-600 to-orange-300 blur-[1px]`}
            style={{
              left: `${Math.random() * 100}%`,
              top: `${Math.random() * 100}%`,
              width: `${Math.random() * 4 + 2}px`,
              height: `${Math.random() * 4 + 2}px`,
              opacity: Math.random() * 0.5 + 0.2,
              animation: `float-up ${Math.random() * 10 + 10}s linear infinite`,
              animationDelay: `${Math.random() * -10}s`,
            }}
          />
        ))
      }
    </div>

    <div
      class="relative z-10 text-center px-6 transition-transform duration-500 ease-out translate-z-0"
      id="parallax-content"
    >
      <div class="relative inline-block mb-8 group">
        <!-- Aura behind text -->
        <div
          class="absolute -inset-4 bg-orange-600/20 rounded-full blur-2xl group-hover:bg-orange-500/30 transition-all duration-700"
        >
        </div>

        <h1
          class="text-[10rem] md:text-[15rem] font-black leading-none tracking-tighter text-transparent bg-clip-text bg-linear-to-b from-orange-300 via-orange-500 to-orange-900 drop-shadow-2xl select-none"
        >
          404
        </h1>
      </div>

      <div class="space-y-4 max-w-2xl mx-auto">
        <h2
          class="text-3xl md:text-5xl font-bold text-white tracking-tight"
          data-i18n="error404.message"
        >
          {getTranslation("error404.message")}
        </h2>

        <p
          class="text-orange-200/60 max-w-md mx-auto text-lg md:text-xl font-light leading-relaxed"
          data-i18n="error404.description"
        >
          {getTranslation("error404.description")}
        </p>
      </div>

      <div class="mt-12">
        <a href="/" class="relative inline-flex items-center group">
          <!-- Button Glow/Shadow -->
          <div
            class="absolute -inset-1 bg-linear-to-r from-orange-600 to-orange-400 rounded-full blur opacity-40 group-hover:opacity-100 transition duration-1000 group-hover:duration-200"
          >
          </div>

          <span
            class="relative px-12 py-5 bg-[#0b0f19] text-white font-bold rounded-full border border-orange-500/30 transition-all duration-300 transform group-hover:scale-105 group-active:scale-95 flex items-center gap-3"
          >
            <span data-i18n="error404.backHome"
              >{getTranslation("error404.backHome")}</span
        >
            <ArrowRight size={20} stroke-width={3} class="transition-transform group-hover:translate-x-1" />
          </span>
        </a>
      </div>
    </div>

    <!-- Decorative Border Aura -->
    <div
      class="absolute inset-0 border-40 border-orange-600/5 pointer-events-none md:block hidden"
    >
    </div>
  </main>
</Layout>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }

  .translate-z-0 {
    transform: translateZ(0);
  }

  @keyframes float-up {
    0% {
      transform: translateY(0) translateX(0) scale(1);
      opacity: 0;
    }
    10% {
      opacity: 0.5;
    }
    90% {
      opacity: 0.5;
    }
    100% {
      transform: translateY(-100vh) translateX(50px) scale(0);
      opacity: 0;
    }
  }

  @keyframes pulse-slow {
    0%,
    100% {
      transform: scale(1.5) rotate(0deg);
      opacity: 0.1;
    }
    50% {
      transform: scale(1.6) rotate(5deg);
      opacity: 0.15;
    }
  }

  .animate-pulse-slow {
    animation: pulse-slow 20s ease-in-out infinite;
  }

  /* Text reflection effect */
  h1 {
    filter: drop-shadow(0 0 30px rgba(234, 88, 12, 0.2));
  }
</style>

<script>
  const container = document.getElementById("parallax-container");
  const content = document.getElementById("parallax-content");

  const handleMouseMove = (e: MouseEvent) => {
    if (!container || !content) return;

    const { clientX, clientY } = e;
    const { innerWidth, innerHeight } = window;

    // Parallax effect
    const moveX = (clientX - innerWidth / 2) / 25;
    const moveY = (clientY - innerHeight / 2) / 25;

    // 3D rotation
    const rotateX = (clientY - innerHeight / 2) / 100;
    const rotateY = (clientX - innerWidth / 2) / 100;

    content.style.transform = `translate3d(${moveX}px, ${moveY}px, 0) rotateX(${-rotateX}deg) rotateY(${rotateY}deg)`;
  };

  window.addEventListener("mousemove", handleMouseMove);
</script>
