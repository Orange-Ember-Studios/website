---
import BlogLayout from "../../../layouts/BlogLayout.astro";
import { getPublishedPostBySlug } from "../../../lib/posts.service";

const { lang, slug } = Astro.params;

if (!lang || !slug) {
  return new Response(null, { status: 404 });
}

// Fetch via Repository/Service pattern, hiding DB logic
const post = await getPublishedPostBySlug(slug, lang);

if (!post) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

const { frontmatter, readingTime, htmlContent } = post;
---

<BlogLayout
  frontmatter={frontmatter}
  postId={`${lang}/${slug}`}
  readingTime={readingTime}
>
  <article
    set:html={htmlContent}
    class="prose prose-invert max-w-none text-neutral-300"
  />
</BlogLayout>
