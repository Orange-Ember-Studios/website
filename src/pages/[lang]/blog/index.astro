---
import Layout from "../../../layouts/Layout.astro";
import Footer from "../../../components/Navigation/Footer.astro";
import Navbar from "../../../components/Navigation/Navbar.vue";
import PremiumSelect from "../../../components/ui/PremiumSelect.vue";
import { getTranslation } from "../../../i18n/i18n";
import { getPublishedPostsByType } from "../../../lib/posts.service";
import { resolveImageUrl } from "../../../lib/images";
import { ArrowRight, FileText, Plus } from '@lucide/astro';

const { lang = "en" } = Astro.props;

const url = new URL(Astro.request.url);
const sortOrder = url.searchParams.get("sort") || "desc";

const allPosts = await getPublishedPostsByType('blog');

const posts = allPosts.filter((p) => {
  if (lang === "en") return !p.id.startsWith("es/") && !p.id.startsWith("fr/");
  return p.id.startsWith(`${lang}/`);
});

posts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return sortOrder === "desc" ? dateB - dateA : dateA - dateB;
});

const allTags = [
  ...new Set(posts.flatMap((post) => post.data.tags || [])),
].sort();

const tagColors: Record<string, string> = {
  "game-dev": "bg-purple-500/20 text-purple-300 border-purple-500/30",
  "web-dev": "bg-blue-500/20 text-blue-300 border-blue-500/30",
  "mobile": "bg-green-500/20 text-green-300 border-green-500/30",
  "performance": "bg-yellow-500/20 text-yellow-300 border-yellow-500/30",
  "tutorial": "bg-ember-500/20 text-ember-300 border-ember-500/30",
};

const getTagStyle = (tag: string) => {
  return `px-3 py-1 rounded-full text-xs font-bold border ${tagColors[tag] || "bg-gray-500/20 text-gray-300 border-gray-500/30"}`;
};

const getPostLang = (id: string) => {
  if (id.startsWith("es/")) return "es";
  if (id.startsWith("fr/")) return "fr";
  return "en";
};

const tagsByLang = {
  en: [
    ...new Set(
      allPosts
        .filter((p) => getPostLang(p.id) === "en")
        .flatMap((p) => p.data.tags || []),
    ),
  ],
  es: [
    ...new Set(
      allPosts
        .filter((p) => getPostLang(p.id) === "es")
        .flatMap((p) => p.data.tags || []),
    ),
  ],
  fr: [
    ...new Set(
      allPosts
        .filter((p) => getPostLang(p.id) === "fr")
        .flatMap((p) => p.data.tags || []),
    ),
  ],
};

const tagOptions = [
  { id: "all", label: "All Topics", i18nKey: "blog.allTopics" },
  ...allTags.map((tag) => ({
    id: tag,
    label: tag,
    color: tagColors[tag] ? undefined : undefined,
    i18nKey: `tag.${tag}`,
  })),
];

const sortOptions = [
  { id: "desc", label: "Newest First", i18nKey: "blog.newest" },
  { id: "asc", label: "Oldest First", i18nKey: "blog.oldest" },
];

const t = (key: string) => getTranslation(key, lang as any);
---

<Layout
  title={`${t("blog.indexTitlePrefix")}${t("blog.indexTitleHighlight")}${t("blog.indexTitleSuffix")} | Orange Ember Studios`}
  description={t("blog.indexDescription")}
>
  <Navbar lang={lang} client:load />

  <main class="pt-32 pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <header class="mb-20 text-center animate-fade-in">
      <h1 class="text-5xl sm:text-7xl font-extrabold text-white mb-6 tracking-tight">
        <span data-i18n="blog.indexTitlePrefix">{t("blog.indexTitlePrefix")}</span
        ><span
          class="text-transparent bg-clip-text bg-linear-to-r from-orange-500 to-red-600"
          data-i18n="blog.indexTitleHighlight"
          >{t("blog.indexTitleHighlight")}</span
        ><span data-i18n="blog.indexTitleSuffix"
          >{t("blog.indexTitleSuffix")}</span
        >
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto" data-i18n="blog.indexDescription">
        {t("blog.indexDescription")}
      </p>
    </header>

    <div
      class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8 animate-fade-in"
      style="animation-delay: 200ms; z-index: 40; position: relative;"
    >
      <PremiumSelect
        id="tag-filter"
        label={t("blog.filterByTopics")}
        labelI18n="blog.filterByTopics"
        options={tagOptions}
        isMultiple={true}
        initialValues={["all"]}
        defaultLabel="All Topics"
        defaultLabelI18n="blog.allTopics"
        class="w-full md:w-auto"
        containerId="tag-filter-container"
        client:load
      />

      <div class="flex flex-col sm:flex-row items-end gap-6 w-full md:w-auto">
        <div class="w-full sm:w-auto">
          <label
            class="text-[10px] uppercase tracking-[0.25em] font-black text-white/30 mb-3 block ml-1"
            data-i18n="blog.statistics"
          >
            {t("blog.statistics")}
          </label>
          <div class="flex items-center space-x-3 text-gray-400 bg-white/5 px-6 rounded-2xl border border-white/10 shadow-lg min-h-[60px]">
            <span class="text-[9px] font-black uppercase tracking-[0.15em] text-white/50" data-i18n="blog.showing"
              >{t("blog.showing")}</span
            >
            <span id="posts-count" class="text-orange-500 font-black text-2xl leading-none">0</span>
            <span class="text-[9px] font-black uppercase tracking-[0.15em] text-white/50" data-i18n="blog.posts"
              >Posts</span
            >
          </div>
        </div>

        <PremiumSelect
          id="sort-filter"
          label={t("blog.sortResults")}
          labelI18n="blog.sortResults"
          options={sortOptions}
          isMultiple={false}
          initialValues={[sortOrder]}
          defaultLabel={sortOrder === "desc" ? "Newest First" : "Oldest First"}
          defaultLabelI18n={sortOrder === "desc" ? "blog.newest" : "blog.oldest"}
          class="w-full sm:w-64"
          containerId="sort-filter-container"
          client:load
        />
      </div>
    </div>

    <div
      id="blog-metadata"
      class="hidden"
      data-tags-by-lang={JSON.stringify(tagsByLang)}
    ></div>

    <div
      id="posts-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
    >
      {
        posts.map((post) => (
          <a
            href={`/${lang}/blog/${post.id.replace(`${lang}/`, "")}`}
            data-post-lang={getPostLang(post.id)}
            data-tags={post.data.tags?.join(",")}
            class="hidden group relative bg-white/5 border border-white/10 rounded-[2.5rem] overflow-hidden hover:border-orange-500/50 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_50px_-12px_rgba(249,115,22,0.2)]"
          >
            {post.data.image && (
              <div class="aspect-16/10 overflow-hidden">
                <img
                  src={resolveImageUrl(post.data.image)}
                  alt={post.data.title}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  transition:name={`image-${post.id}`}
                />
              </div>
            )}

            <div class="p-8">
              <div class="flex flex-wrap items-center gap-2 mb-4">
                {post.data.tags?.slice(0, 3).map((tag) => (
                  <span class={getTagStyle(tag)}>
                    <span data-tag-id={tag}>{tag}</span>
                  </span>
                ))}
                <span class="text-xs text-gray-500 ml-auto">
                  {post.data.pubDate.toLocaleDateString(
                    lang === "en" ? "en-US" : lang === "es" ? "es-ES" : "fr-FR",
                    {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    },
                  )}
                </span>
              </div>

              <h2
                class="text-2xl font-bold text-white mb-4 leading-snug group-hover:text-orange-400 transition-colors"
                transition:name={`title-${post.id}`}
              >
                {post.data.title}
              </h2>

              <p class="text-gray-400 line-clamp-3 mb-6 text-sm leading-relaxed">
                {post.data.description}
              </p>

              <div class="flex items-center text-white font-bold text-sm group-hover:translate-x-1 transition-transform">
                <span data-i18n="blog.readStory">{t("blog.readStory")}</span>
                <ArrowRight class="h-4 w-4 ml-2 text-orange-500" />
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div
      id="blog-empty-state"
      class="hidden flex-col items-center justify-center py-20 text-center"
    >
      <div class="w-20 h-20 mb-6 rounded-full bg-white/5 flex items-center justify-center text-orange-500">
        <FileText class="h-10 w-10" />
      </div>
      <h3 class="text-2xl font-bold text-white mb-2" data-i18n="blog.noPostsTitle">
        No posts found
      </h3>
      <p class="text-gray-400 max-w-sm" data-i18n="blog.noPostsDesc">
        {t("blog.noPostsDesc")}
      </p>
    </div>

    <div
      id="blog-pagination"
      class="mt-20 flex-col items-center animate-fade-in hidden"
      style="animation-delay: 400ms;"
    >
      <div class="mb-8 flex flex-col items-center w-full max-w-xs">
        <div class="flex justify-between w-full mb-3 px-1">
          <span
            class="text-[10px] uppercase tracking-[0.2em] font-black text-white/40"
            id="pagination-status"
          >
            {t("blog.showingCount").replace("{visible}", "0").replace("{total}", "0")}
          </span>
        </div>
        <div class="w-full h-1 bg-white/5 rounded-full overflow-hidden border border-white/5">
          <div
            id="pagination-progress"
            class="h-full bg-linear-to-r from-orange-500 to-red-600 transition-all duration-700 ease-out"
            style="width: 0%"
          ></div>
        </div>
      </div>

      <button
        id="load-more-btn"
        class="group relative px-10 py-5 bg-white/5 border border-white/10 rounded-2xl text-white font-black uppercase tracking-[0.2em] text-xs hover:bg-orange-500 hover:border-orange-500 transition-all duration-500 hover:shadow-[0_0_40px_rgba(249,115,22,0.4)] active:scale-95 cursor-pointer overflow-hidden"
      >
        <span class="relative z-10 flex items-center">
          <span data-i18n="blog.loadMore">{t("blog.loadMore")}</span>
          <Plus class="h-4 w-4 ml-3 transition-transform duration-500 group-hover:rotate-90" />
        </span>
        <div class="absolute inset-0 bg-linear-to-r from-orange-600 to-red-600 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
      </button>

      <p id="all-loaded-msg" class="hidden text-gray-500 text-sm font-medium italic" data-i18n="blog.allLoaded">
        {t("blog.allLoaded")}
      </p>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { getCurrentLanguage, getTranslation } from "../../../i18n/i18n";

  document.addEventListener("astro:page-load", () => {
    const DEFAULT_PAGE_SIZE = 9;
    let visibleLimit = DEFAULT_PAGE_SIZE;
    let selectedTags = new Set<string>();
    const metadata = document.getElementById("blog-metadata");
    const tagsByLang = metadata
      ? JSON.parse(metadata.getAttribute("data-tags-by-lang") || "{}")
      : {};
    const tagFilterContainer = document.getElementById("tag-filter-container");
    const sortFilterContainer = document.getElementById("sort-filter-container");
    const loadMoreBtn = document.getElementById("load-more-btn");
    const paginationContainer = document.getElementById("blog-pagination");
    const paginationProgress = document.getElementById("pagination-progress");
    const paginationStatus = document.getElementById("pagination-status");
    const allLoadedMsg = document.getElementById("all-loaded-msg");

    const translateTags = () => {
      const tagElements = document.querySelectorAll("[data-tag-id]");
      tagElements.forEach((el) => {
        const tagId = el.getAttribute("data-tag-id");
        if (tagId) {
          el.textContent = getTranslation(`tag.${tagId}`);
        }
      });
      updateTagVisibility();
      updateTagLabels();
      updatePaginationLabels();
    };

    const updatePaginationLabels = () => {
      if (paginationStatus) {
        const visibleDisplay = paginationStatus.getAttribute("data-visible") || "0";
        const totalDisplay = paginationStatus.getAttribute("data-total") || "0";
        paginationStatus.textContent = getTranslation("blog.showingCount")
          .replace("{visible}", visibleDisplay)
          .replace("{total}", totalDisplay);
      }
    };

    const updateTagLabels = () => {
      const triggerLabel = tagFilterContainer?.querySelector(".selected-label");
      if (triggerLabel)
        triggerLabel.textContent = selectedTags.size === 0 || selectedTags.has("all")
          ? getTranslation("blog.allTopics") || "All Topics"
          : selectedTags.size === 1
            ? getTranslation(`tag.${Array.from(selectedTags)[0]}`)
            : `${selectedTags.size} ${getTranslation("blog.selected")}`;
    };

    const updateTagVisibility = () => {
      const lang = getCurrentLanguage();
      const currentLangTags = tagsByLang[lang] || [];
      const tagOptionBtns = tagFilterContainer?.querySelectorAll('.option-btn[data-value]:not([data-value="all"])');
      tagOptionBtns?.forEach((btn) => {
        const tag = btn.getAttribute("data-value");
        if (tag && currentLangTags.includes(tag)) {
          (btn as HTMLElement).style.display = "flex";
        } else {
          (btn as HTMLElement).style.display = "none";
          if (tag && selectedTags.has(tag)) selectedTags.delete(tag);
        }
      });
    };

    const filterPosts = (isLoadMore = false) => {
      const currentLang = getCurrentLanguage();
      const posts = document.querySelectorAll("[data-post-lang]");
      const emptyState = document.getElementById("blog-empty-state");
      const postsCount = document.getElementById("posts-count");

      let totalMatching = 0;
      let visibleInFilter = 0;

      const matchingPosts: HTMLElement[] = [];
      posts.forEach((post) => {
        const postLang = post.getAttribute("data-post-lang");
        const postTags = post.getAttribute("data-tags")?.split(",") || [];

        const langMatch = postLang === currentLang;
        const tagMatch =
          selectedTags.size === 0 ||
          selectedTags.has("all") ||
          Array.from(selectedTags).some((t) => postTags.includes(t));

        if (langMatch && tagMatch) {
          matchingPosts.push(post as HTMLElement);
          totalMatching++;
        } else {
          post.classList.remove("block");
          post.classList.add("hidden");
        }
      });

      matchingPosts.forEach((post, index) => {
        if (index < visibleLimit) {
          post.classList.remove("hidden");
          post.classList.add("block");
          visibleInFilter++;
        } else {
          post.classList.remove("block");
          post.classList.add("hidden");
        }
      });

      if (postsCount) postsCount.textContent = totalMatching.toString();

      if (totalMatching > 0) {
        paginationContainer?.classList.remove("hidden");
        paginationContainer?.classList.add("flex");

        if (visibleInFilter < totalMatching) {
          loadMoreBtn?.classList.remove("hidden");
          allLoadedMsg?.classList.add("hidden");
        } else {
          loadMoreBtn?.classList.add("hidden");
          allLoadedMsg?.classList.remove("hidden");
        }

        const percentage = Math.round((visibleInFilter / totalMatching) * 100);
        if (paginationProgress) paginationProgress.style.width = `${percentage}%`;

        if (paginationStatus) {
          paginationStatus.setAttribute("data-visible", visibleInFilter.toString());
          paginationStatus.setAttribute("data-total", totalMatching.toString());
          updatePaginationLabels();
        }
      } else {
        paginationContainer?.classList.remove("flex");
        paginationContainer?.classList.add("hidden");
      }

      if (totalMatching === 0) {
        emptyState?.classList.remove("hidden");
        emptyState?.classList.add("flex");
      } else {
        emptyState?.classList.remove("flex");
        emptyState?.classList.add("hidden");
      }
    };

    loadMoreBtn?.addEventListener("click", () => {
      visibleLimit += DEFAULT_PAGE_SIZE;
      filterPosts(true);
    });

    tagFilterContainer?.addEventListener("change", (e: any) => {
      const { values } = e.detail;
      selectedTags = new Set(values);
      visibleLimit = DEFAULT_PAGE_SIZE;
      updateTagLabels();
      filterPosts();
    });

    sortFilterContainer?.addEventListener("change", (e: any) => {
      const { values } = e.detail;
      const sortVal = values[0];
      if (sortVal) {
        const url = new URL(window.location.href);
        url.searchParams.set("sort", sortVal);
        window.location.href = url.toString();
      }
    });

    translateTags();
    filterPosts();

    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === "lang") {
          translateTags();
          filterPosts();
        }
      });
    });
    observer.observe(document.documentElement, { attributes: true });
  });
</script>

<style>
  .animate-fade-in {
    animation: fadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
