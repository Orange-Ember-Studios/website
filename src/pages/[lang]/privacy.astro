---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navigation/Navbar.astro";
import Footer from "../../components/Navigation/Footer.astro";
import { getTranslation } from "../../i18n/i18n";

const { lang = "en" } = Astro.params;
const t = (key: string) => getTranslation(key, lang as any);
---
<Layout
  title={`${t("privacy.title")} | Orange Ember Studios`}
  description={t("privacy.description")}
>
  <Navbar lang={lang} />
  <main class="pt-32 pb-24 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto relative">
    <div
      class="absolute top-10 -left-32 w-96 h-96 bg-ember-500/10 rounded-full blur-[120px] pointer-events-none"
      aria-hidden="true"
    />

    <header class="relative mb-14">
      <div class="flex flex-wrap items-center gap-4 mb-4">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white" data-i18n="privacy.title">
          {t("privacy.title")}
        </h1>
      </div>
      <p
        class="inline-flex items-center gap-2 rounded-full border border-ember-500/30 bg-ember-500/10 px-4 py-1.5 text-xs font-semibold tracking-widest uppercase text-ember-300 mb-5"
        data-i18n="privacy.lastUpdated"
      >
        {t("privacy.lastUpdated")}
      </p>
      <div class="flex flex-col md:flex-row items-start md:items-center gap-4">
        <div class="w-20 h-1 bg-linear-to-r from-ember-500 to-ember-700 rounded-full shrink-0" />
        <p class="text-gray-400 text-lg max-w-2xl" data-i18n="privacy.intro">
          {t("privacy.intro")}
        </p>
      </div>
    </header>

    <div class="relative grid gap-8">
      {
        ([
          "dataCollection",
          "cookies",
          "security",
        ] as const).map((sec) => (
          <section class="group relative overflow-hidden rounded-2xl border border-white/5 bg-ash-950/60 p-8 md:p-10 shadow-2xl hover:border-ember-500/30 hover:shadow-[0_0_40px_rgba(255,91,13,0.12)] transition-all duration-500">
            <div class="w-10 h-[3px] bg-linear-to-r from-ember-500 to-ember-700 rounded-full mb-5" />
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-4" data-i18n={`privacy.${sec}Title`}>
              {t(`privacy.${sec}Title`)}
            </h2>
            <p class="text-gray-400 leading-relaxed" data-i18n={`privacy.${sec}Desc`}>
              {t(`privacy.${sec}Desc`)}
            </p>
          </section>
        ))
      }

      <section
        class="relative overflow-hidden rounded-2xl border border-ember-500/20 bg-linear-to-br from-ember-500/10 to-void-500/5 p-8 md:p-10 shadow-2xl"
      >
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4" data-i18n="privacy.contactTitle">
          {t("privacy.contactTitle")}
        </h2>
        <p class="text-gray-300 leading-relaxed">
          <span data-i18n="privacy.contactDesc">{t("privacy.contactDesc")}</span>
          <a
            href="mailto:privacy@orangeember.com"
            class="inline-flex items-center gap-2 mt-4 font-semibold text-ember-300 hover:text-ember-200 underline decoration-ember-500/40 underline-offset-4 transition-colors"
          >
            privacy@orangeember.com
          </a>.
        </p>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
