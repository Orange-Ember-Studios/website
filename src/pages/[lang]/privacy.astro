---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navigation/Navbar.astro";
import Footer from "../../components/Navigation/Footer.astro";
import { getTranslation } from "../../i18n/i18n";

const { lang = "en" } = Astro.params;
const t = (key: string) => getTranslation(key, lang as any);
---

<Layout
  title={`${t("privacy.title")} | Orange Ember Studios`}
  description={t("privacy.description")}
>
  <Navbar />
  <main class="pt-32 pb-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <h1 class="text-4xl md:text-5xl font-bold text-white mb-4" data-i18n="privacy.title">
      {t("privacy.title")}
    </h1>
    <p class="text-gray-500 mb-10" data-i18n="privacy.lastUpdated">
      {t("privacy.lastUpdated")}
    </p>
    <div class="prose prose-invert prose-lg max-w-none text-gray-300">
      <p data-i18n="privacy.intro">{t("privacy.intro")}</p>

      <h2 data-i18n="privacy.dataCollectionTitle">{t("privacy.dataCollectionTitle")}</h2>
      <p data-i18n="privacy.dataCollectionDesc">{t("privacy.dataCollectionDesc")}</p>

      <h2 data-i18n="privacy.cookiesTitle">{t("privacy.cookiesTitle")}</h2>
      <p data-i18n="privacy.cookiesDesc">{t("privacy.cookiesDesc")}</p>

      <h2 data-i18n="privacy.securityTitle">{t("privacy.securityTitle")}</h2>
      <p data-i18n="privacy.securityDesc">{t("privacy.securityDesc")}</p>

      <h2 data-i18n="privacy.contactTitle">{t("privacy.contactTitle")}</h2>
      <p>
        <span data-i18n="privacy.contactDesc">{t("privacy.contactDesc")}</span>
        <a href="mailto:privacy@orangeember.com">privacy@orangeember.com</a>.
      </p>
    </div>
  </main>
  <Footer />
</Layout>
