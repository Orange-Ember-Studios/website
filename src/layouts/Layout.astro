---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { API_URLS, SITE_URLS, SOCIAL_URLS, EXTERNAL_URLS } from "../constants/urls";
import { resolveImageUrl } from "../lib/images";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  titleKey?: string;
  extraSchema?: any[];
}

const {
  title,
  description = "Orange Ember Studios. Crafting extraordinary digital experiences. We forge premium video games, web, and mobile applications.",
  image = "/Shield.svg", // Using the Shield as fallback OpenGraph image
  noindex = false,
  titleKey = "meta.title",
  extraSchema = [],
} = Astro.props;

const resolvedImage = resolveImageUrl(image);
const fullImageUrl = resolvedImage.startsWith('http') ? resolvedImage : new URL(resolvedImage, SITE_URLS.BASE).toString();

const lang = Astro.locals.lang || "en";

const organizationSchema = {
  "@context": EXTERNAL_URLS.SCHEMA_ORG,
  "@type": "Organization",
  "name": "Orange Ember Studios",
  "url": SITE_URLS.BASE,
  "logo": `${SITE_URLS.BASE}/favicon.svg`,
  "description": description,
  "sameAs": [
    SOCIAL_URLS.GITHUB,
    SOCIAL_URLS.TWITTER_X
  ]
};

const breadcrumbSchema = {
  "@context": EXTERNAL_URLS.SCHEMA_ORG,
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": SITE_URLS.BASE
    }
  ]
};

// If we are in a subpath, we should ideally add it to breadcrumbs
// This is a simplified version
if (typeof Astro.url !== 'undefined' && Astro.url.pathname !== '/') {
  const paths = Astro.url.pathname.split('/').filter(Boolean);
  paths.forEach((path, index) => {
    breadcrumbSchema.itemListElement.push({
      "@type": "ListItem",
      "position": index + 2,
      "name": path.charAt(0).toUpperCase() + path.slice(1),
      "item": `${SITE_URLS.BASE}/${paths.slice(0, index + 1).join('/')}`
    });
  });
}

const websiteSchema = {
  "@context": EXTERNAL_URLS.SCHEMA_ORG,
  "@type": "WebSite",
  "name": "Orange Ember Studios",
  "url": SITE_URLS.BASE
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="author" content="Orange Ember Studios" />
    <meta name="publisher" content="Orange Ember Studios" />
    <meta name="generator" content={Astro.generator} />
    <meta 
      name="description" 
      content={description} 
      data-i18n="meta.description"
      data-i18n-attr="content"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#18191f" />
    <title data-i18n={titleKey}>{title}</title>

    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={SITE_URLS.BASE + "/"} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URLS.BASE + "/"} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_ES" />
    <meta property="og:locale:alternate" content="fr_FR" />
    <meta 
      property="og:title" 
      content={title} 
      data-i18n={titleKey}
      data-i18n-attr="content"
    />
    <meta 
      property="og:description" 
      content={description} 
      data-i18n="meta.description"
      data-i18n-attr="content"
    />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:alt" content="Orange Ember Studios" />
    <meta property="og:site_name" content="Orange Ember Studios" />
    <meta property="og:logo" content={`${SITE_URLS.BASE}/favicon.svg`} />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={SITE_URLS.BASE + "/"} />
    <meta property="twitter:site" content="@OrangeEmberSt" />
    <meta property="twitter:creator" content="@OrangeEmberSt" />
    <meta 
      property="twitter:title" 
      content={title} 
      data-i18n={titleKey}
      data-i18n-attr="content"
    />
    <meta 
      property="twitter:description" 
      content={description} 
      data-i18n="meta.description"
      data-i18n-attr="content"
    />
    <meta
      property="twitter:image"
      content={fullImageUrl}
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {extraSchema.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Load Google Fonts -->
    <link rel="preconnect" href={EXTERNAL_URLS.GOOGLE_FONTS} />
    <link rel="preconnect" href={EXTERNAL_URLS.GOOGLE_GSTATIC} crossorigin />
    <link
      href={`${EXTERNAL_URLS.GOOGLE_FONTS}/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap`}
      rel="stylesheet"
    />

    <!-- Initialize i18n -->
    <script>
      import { initI18n } from "../i18n/i18n";
      document.addEventListener("astro:page-load", () => {
        initI18n();
      });
    </script>

    <!-- CSP and Policies for Turnstile and external services -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:;" />
    <meta http-equiv="Permissions-Policy" content="xr-spatial-tracking=()" />

    <!-- Cloudflare Turnstile -->
    <script src={API_URLS.TURNSTILE_SCRIPT} async defer></script>
    <ClientRouter />
  </head>
  <body
    class="bg-[#0b0f19] text-[#f3f4f6] font-['Outfit',sans-serif] antialiased selection:bg-orange-500/30 selection:text-orange-200"
  >
    <slot />
  </body>
</html>
