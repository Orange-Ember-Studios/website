---
import Layout from "./Layout.astro";
import Navbar from "../components/Navigation/Navbar.astro";
import Footer from "../components/Navigation/Footer.astro";
import { SOCIAL_URLS } from "../constants/urls";
import { getTagStyle } from "../components/blog/tagMetadata";
import { getTranslation } from "../i18n/i18n";
import { resolveImageUrl } from "../lib/images";
import { ArrowLeft, Clock, Heart, Share2, X } from "@lucide/astro";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    pubDate: Date | string;
    author: string;
    image?: string;
    tags?: string[];
  };
  postId: string;
  readingTime?: number;
  /** Server-rendered like count for this post (`lang/slug`). */
  initialLikeCount?: number;
}

const { frontmatter, postId, readingTime = 5, initialLikeCount = 0 } = Astro.props;
const { title, description, pubDate, author, image, tags } = frontmatter;
const resolvedImage = resolveImageUrl(image);

const lang = Astro.locals.lang || "en";

const formattedDate = new Date(pubDate).toLocaleDateString(
  lang === "en" ? "en-US" : lang === "es" ? "es-ES" : "fr-FR",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  },
);
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": resolvedImage,
  "datePublished": new Date(pubDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Orange Ember Studios",
    "logo": {
      "@type": "ImageObject",
      "url": "https://orangeember.com/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://orangeember.com/${lang}/blog/${postId.split('/').pop()}`
  }
};
---

<Layout
  title={`${title} | Orange Ember Blog`}
  description={description}
  image={resolvedImage}
  extraSchema={[blogSchema]}
>
  <Navbar />

  <main class="pt-32 pb-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <!-- Breadcrumbs / Back Link -->
    <div class="mb-8">
      <a
        href={`/${lang}/blog`}
        class="inline-flex items-center text-orange-500 hover:text-orange-400 font-medium transition-colors duration-200 group"
      >
        <ArrowLeft class="h-5 w-5 mr-2 transform group-hover:-translate-x-1 transition-transform duration-200" />
        <span data-i18n="post.backToBlog"
          >{getTranslation("post.backToBlog", lang as any)}</span
        >
      </a>
    </div>

    <!-- Header -->
    <header class="mb-12 animate-fade-in">
      {
        tags && (
          <div class="flex flex-wrap gap-2 mb-6">
            {tags.map((tag) => (
              <span class={getTagStyle(tag)}>{tag}</span>
            ))}
          </div>
        )
      }

      <h1
        class="text-4xl sm:text-6xl font-extrabold text-white mb-8 leading-tight tracking-tight"
        transition:name={`title-${postId}`}
      >
        {title}
      </h1>

      <div class="flex items-center space-x-6 text-gray-400">
        <div class="flex items-center">
          <div
            class="h-12 w-12 rounded-2xl bg-linear-to-br from-orange-500 to-red-600 flex items-center justify-center text-white font-bold mr-4 shadow-xl shadow-orange-500/20 rotate-3 group-hover:rotate-0 transition-transform"
          >
            {author.charAt(0)}
          </div>
          <div>
            <p class="text-gray-100 font-semibold">{author}</p>
            <p class="text-sm">{formattedDate}</p>
          </div>
        </div>
        <div class="h-8 w-px bg-white/10 hidden sm:block"></div>
        <div class="hidden sm:flex items-center text-sm font-medium">
          <Clock class="h-5 w-5 mr-2 text-orange-500" />
          <span>
            {
              getTranslation("post.estReadTime", lang as any).replace(
                "{time}",
                readingTime.toString(),
              )
            }
          </span>
        </div>
      </div>
    </header>

    <!-- Featured Image -->
    {
      resolvedImage && (
        <div class="relative w-full aspect-21/9 rounded-4xl overflow-hidden mb-16 shadow-[0_0_50px_-12px_rgba(249,115,22,0.3)] ring-1 ring-white/10">
          <img
            src={resolvedImage}
            alt={title}
            class="w-full h-full object-cover"
            transition:name={`image-${postId}`}
          />
          <div class="absolute inset-0 bg-linear-to-t from-[#0b0f19] via-transparent to-transparent opacity-60" />
        </div>
      )
    }

    <!-- Content -->
    <article class="blog-content prose-premium">
      <slot />
    </article>

    <!-- Likes & share -->
    <div
      class="mt-12 flex flex-wrap items-center gap-4"
      data-blog-engagement
      data-post-key={postId}
      data-initial-count={initialLikeCount}
    >
      <button
        type="button"
        data-like-btn
        class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-gray-200 transition hover:border-orange-500/40 hover:bg-orange-500/10 hover:text-white disabled:cursor-not-allowed disabled:opacity-60"
        aria-pressed="false"
      >
        <Heart
          class="h-5 w-5 text-orange-500 transition-transform"
          data-like-icon
          stroke-width="2"
        />
        <span data-like-count>{initialLikeCount}</span>
      </button>

      <div class="relative">
        <button
          type="button"
          data-share-toggle
          class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-gray-200 transition hover:border-white/20 hover:bg-white/10 hover:text-white"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <Share2 class="h-5 w-5 text-orange-500" stroke-width="2" />
          <span data-i18n="post.share">{getTranslation("post.share", lang as any)}</span>
        </button>
        <div
          data-share-menu
          class="pointer-events-none invisible absolute left-0 top-full z-20 mt-2 min-w-[200px] translate-y-1 rounded-xl border border-white/10 bg-[#0b0f19] p-2 opacity-0 shadow-xl shadow-black/40 transition-all duration-200"
          role="menu"
        >
          <a
            href="#"
            data-share-x
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-gray-200 hover:bg-white/10"
            role="menuitem"
          >
            <X class="h-4 w-4 shrink-0" stroke-width="2" />
            <span data-i18n="post.shareOnX">{getTranslation("post.shareOnX", lang as any)}</span>
          </a>
          <a
            href="#"
            data-share-linkedin
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-gray-200 hover:bg-white/10"
            role="menuitem"
          >
            <svg
              class="h-4 w-4 shrink-0 text-[#0A66C2]"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              />
            </svg>
            <span data-i18n="post.shareOnLinkedIn">{getTranslation("post.shareOnLinkedIn", lang as any)}</span>
          </a>
          <a
            href="#"
            data-share-whatsapp
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-gray-200 hover:bg-white/10"
            role="menuitem"
          >
            <svg
              class="h-4 w-4 shrink-0 text-[#25D366]"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.883 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              />
            </svg>
            <span data-i18n="post.shareOnWhatsApp">{getTranslation("post.shareOnWhatsApp", lang as any)}</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Post Navigation / Footer -->
    <footer class="mt-20 pt-10 border-t border-white/5">
      <div
        class="bg-linear-to-br from-white/5 to-transparent rounded-4xl p-8 sm:p-12 border border-white/10"
      >
        <div
          class="flex flex-col md:flex-row justify-between items-center gap-8"
        >
          <div>
            <h3
              class="text-2xl font-bold text-white mb-2"
              data-i18n="post.enjoyedPost"
            >
              {getTranslation("post.enjoyedPost", lang as any)}
            </h3>
            <p class="text-gray-400" data-i18n="post.stayUpdated">
              {getTranslation("post.stayUpdated", lang as any)}
            </p>
          </div>
          <div class="flex gap-4">
            <a
              href={SOCIAL_URLS.TWITTER_X}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center space-x-2 px-6 py-3 rounded-xl bg-white text-black font-bold hover:bg-orange-500 hover:text-white transition-all duration-300"
            >
              <span data-i18n="post.followX"
                >{getTranslation("post.followX", lang as any)}</span
              >
              <X class="h-5 w-5" />
            </a>
          </div>
        </div>
      </div>
    </footer>
  </main>

  <Footer />
</Layout>

<script>
  let engagementDocClose: (() => void) | null = null;

  const VISITOR_LS = 'oe-blog-visitor-id';
  const UUID_RE =
    /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

  function getOrCreateVisitorId() {
    try {
      const existing = localStorage.getItem(VISITOR_LS);
      if (existing && UUID_RE.test(existing)) return existing;
      const id = crypto.randomUUID();
      localStorage.setItem(VISITOR_LS, id);
      return id;
    } catch {
      return null;
    }
  }

  function setupBlogEngagement() {
    if (engagementDocClose) {
      engagementDocClose();
      engagementDocClose = null;
    }

    const root = document.querySelector('[data-blog-engagement]');
    if (!root) return;

    const postKey = root.getAttribute('data-post-key') || '';
    const likeBtn = root.querySelector('[data-like-btn]');
    const likeCountEl = root.querySelector('[data-like-count]');
    const likeIcon = root.querySelector('[data-like-icon]');
    const shareToggle = root.querySelector('[data-share-toggle]');
    const shareMenu = root.querySelector('[data-share-menu]');
    const shareX = root.querySelector('[data-share-x]');
    const shareLinkedin = root.querySelector('[data-share-linkedin]');
    const shareWhatsapp = root.querySelector('[data-share-whatsapp]');

    if (!likeBtn || !likeCountEl || !postKey) return;

    const likeButton = likeBtn as HTMLButtonElement;
    const likeCount = likeCountEl as HTMLElement;
    const pageUrl = window.location.href;
    const pageTitle = document.title || '';

    function setLikedUi(liked: boolean) {
      likeButton.setAttribute('aria-pressed', liked ? 'true' : 'false');
      if (likeIcon) {
        if (liked) {
          likeIcon.setAttribute('fill', 'currentColor');
          likeIcon.classList.add('fill-orange-500');
        } else {
          likeIcon.removeAttribute('fill');
          likeIcon.classList.remove('fill-orange-500');
        }
      }
      likeButton.disabled = liked;
    }

    function openShareMenu(open: boolean) {
      if (!shareToggle || !shareMenu) return;
      shareToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        shareMenu.classList.remove(
          'pointer-events-none',
          'invisible',
          'opacity-0',
          'translate-y-1',
        );
        shareMenu.classList.add('opacity-100', 'translate-y-0');
      } else {
        shareMenu.classList.add(
          'pointer-events-none',
          'invisible',
          'opacity-0',
          'translate-y-1',
        );
        shareMenu.classList.remove('opacity-100', 'translate-y-0');
      }
    }

    if (shareX)
      shareX.setAttribute(
        'href',
        `https://twitter.com/intent/tweet?text=${encodeURIComponent(pageTitle)}&url=${encodeURIComponent(pageUrl)}`,
      );
    if (shareLinkedin)
      shareLinkedin.setAttribute(
        'href',
        `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`,
      );
    if (shareWhatsapp)
      shareWhatsapp.setAttribute(
        'href',
        `https://wa.me/?text=${encodeURIComponent(`${pageTitle} ${pageUrl}`)}`,
      );

    shareToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = shareToggle.getAttribute('aria-expanded') === 'true';
      openShareMenu(!open);
    });

    shareMenu?.addEventListener('click', (e) => e.stopPropagation());

    const closeShare = () => openShareMenu(false);
    document.addEventListener('click', closeShare);
    engagementDocClose = () => document.removeEventListener('click', closeShare);

    async function refreshLikes() {
      const visitorId = getOrCreateVisitorId();
      const q = visitorId
        ? `postKey=${encodeURIComponent(postKey)}&visitorId=${encodeURIComponent(visitorId)}`
        : `postKey=${encodeURIComponent(postKey)}`;
      try {
        const res = await fetch(`/api/blog/likes?${q}`);
        if (!res.ok) return;
        const data = await res.json();
        if (typeof data.count === 'number') likeCount.textContent = String(data.count);
        if (data.liked) setLikedUi(true);
        else setLikedUi(false);
      } catch {
        /* ignore */
      }
    }

    likeButton.addEventListener('click', async () => {
      if (likeButton.getAttribute('aria-pressed') === 'true') return;
      const visitorId = getOrCreateVisitorId();
      if (!visitorId) return;
      try {
        const res = await fetch('/api/blog/likes', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ postKey, visitorId }),
        });
        if (!res.ok) return;
        const data = await res.json();
        if (typeof data.count === 'number') likeCount.textContent = String(data.count);
        if (data.liked) setLikedUi(true);
      } catch {
        /* ignore */
      }
    });

    void refreshLikes();
  }

  function setupCopyButtons() {
    const buttons = document.querySelectorAll('.copy-button');
    
    buttons.forEach(button => {
      button.addEventListener('click', async () => {
        const code = decodeURIComponent(button.getAttribute('data-code') || '');
        const span = button.querySelector('span');
        const svg = button.querySelector('svg');
        
        try {
          await navigator.clipboard.writeText(code);
          
          if (span) span.textContent = 'Copied!';
          if (svg) svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />';
          
          button.classList.add('text-green-400');
          
          setTimeout(() => {
            if (span) span.textContent = 'Copy';
            if (svg) svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />';
            button.classList.remove('text-green-400');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy: ', err);
        }
      });
    });
  }

  function setupBlogLayoutClient() {
    setupCopyButtons();
    setupBlogEngagement();
  }

  setupBlogLayoutClient();
  document.addEventListener('astro:after-swap', setupBlogLayoutClient);
</script>

<style is:global>
  @reference "../styles/global.css";

  .animate-fade-in {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Premium Content Styles */
  .prose-premium {
    @apply text-gray-300 leading-relaxed text-lg;
  }

  .prose-premium h2 {
    @apply text-3xl font-bold text-white mt-12 mb-6 tracking-tight;
  }

  .prose-premium h3 {
    @apply text-2xl font-bold text-white mt-8 mb-4 tracking-tight;
  }

  .prose-premium p {
    @apply mb-6;
  }

  .prose-premium strong {
    @apply text-white font-semibold;
  }

  .prose-premium a {
    @apply text-orange-400 no-underline border-b border-orange-500/30 hover:border-orange-500 hover:text-orange-300 transition-all;
  }

  .prose-premium ul,
  .prose-premium ol {
    @apply space-y-3 mb-8;
  }

  .prose-premium ul {
    @apply list-none ml-4;
  }

  .prose-premium ol {
    @apply list-decimal ml-8;
  }

  .prose-premium ul li {
    @apply relative pl-6;
  }

  .prose-premium ul li::before {
    content: "";
    @apply absolute left-0 top-[0.6em] h-1.5 w-1.5 rounded-full bg-orange-500 shadow-[0_0_8px_rgba(249,115,22,0.6)];
  }

  .prose-premium blockquote {
    @apply italic border-l-4 border-orange-600 bg-orange-500/5 px-8 py-6 rounded-r-2xl my-10 text-xl text-gray-200;
  }

  .prose-premium pre {
    @apply bg-[#0d1117] rounded-2xl p-6 border border-white/5 my-8 overflow-x-auto shadow-2xl;
  }

  .prose-premium :not(pre) > code {
    @apply text-orange-400 font-mono text-sm bg-white/10 px-1.5 py-0.5 rounded border border-white/5;
  }

  /* Shiki Overrides */
  .code-block-wrapper pre {
    @apply !bg-transparent !m-0 !p-6 !border-none !shadow-none !rounded-none;
  }

  .code-block-wrapper code {
    @apply !bg-transparent !p-0 !text-inherit !text-sm;
  }

  .custom-scrollbar::-webkit-scrollbar {
    height: 8px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    @apply bg-transparent;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    @apply bg-white/10 rounded-full hover:bg-white/20 transition-colors;
  }

  .prose-premium img {
    @apply rounded-3xl my-12 shadow-2xl ring-1 ring-white/10;
  }
</style>
